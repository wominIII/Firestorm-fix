<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="status">
	<panel name="parcel_info_panel">
		<button name="buy_land_btn" tool_tip="此地块可购买。"/>
		<text name="parcel_info_text" value="(加载中)" tool_tip="你所在的地块的名称。点击打开土地信息。"/>
	</panel>
	<panel.string name="packet_loss_tooltip">
		数据包损失
	</panel.string>
	<panel.string name="bandwidth_tooltip">
		带宽
	</panel.string>
	<panel.string name="time">
		[hour, datetime, slt]:[min, datetime, slt]:[second, datetime, slt] [timezone, datetime, slt]
	</panel.string>
	<panel.string name="buycurrencylabel">
		[AMT] L$
	</panel.string>
	<panel name="menu_search_panel">
		<search_editor label="搜索选项" name="search_menu_edit" tool_tip="在这里输入你想搜索的字词。 若在选项中有全文配对到结果，将会显示部分结果。"/>
	</panel>
	<panel name="balance_bg">
		<text name="balance" tool_tip="点击以更新L$余额" value="?? L$"/>
		<button label="购买L$" name="buyL" tool_tip="点击此处购买更多的L$"/>
	</panel>
	<panel name="time_and_media_bg">
		<icon name="dd_icon" tool_tip="视野范围"/>
		<slider tool_tip="与相机的最大距离（米）" name="drawdistance"/>
		<text name="TimeText" tool_tip="当前时间（太平洋时间）"/>
		<button name="stream_toggle_btn" tool_tip="启动/停止地块音频流"/>
		<button name="media_toggle_btn" tool_tip="启动/停止所有媒体（音乐，视频，网站）"/>
		<button name="volume_btn" tool_tip="总音量控制"/>
		<text name="FPSText" tool_tip="每秒帧数" />
	</panel>
</panel>
