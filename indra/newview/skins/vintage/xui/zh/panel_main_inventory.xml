		<combo_box.item value="filter_type_settings" label="环境设置" />
		<combo_box.item value="filter_type_folders" label="文件夹" />
		<combo_box.item value="filter_type_coalesced" label="仅合并物件"/>
		<combo_box.item value="filter_type_custom" label="自定义..."/>
	</combo_box>
	<panel name="default_inventory_panel">
		<tab_container name="inventory filter tabs">
			<inventory_panel label="库存" name="All Items"/>
			<recent_inventory_panel label="最近" name="Recent Items"/>
			<worn_inventory_panel label="装扮" name="Worn Items"/>
		</tab_container>
	</panel>
	<text name="ItemcountText" tool_tip="物件 [ITEMS]，文件夹 [CATEGORIES]">
		物件
	</text>
