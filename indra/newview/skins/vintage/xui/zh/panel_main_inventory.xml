		<combo_box.item value="filter_type_all" label="全部"/>
		<combo_box.item value="filter_type_animations" label="动画"/>
		<combo_box.item value="filter_type_calling_cards" label="名片"/>
		<combo_box.item value="filter_type_clothing" label="服装/身体部位"/>
