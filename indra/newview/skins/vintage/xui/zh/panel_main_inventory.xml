			<button name="back_btn" tool_tip="后退"/>
			<button name="forward_btn" tool_tip="前进"/>
			<button name="up_btn" tool_tip="上一层"/>
		</layout_panel>
		<layout_panel name="filter_panel">
			<filter_editor label="过滤库存" name="inventory search editor" tool_tip="键入一个或多个用'+'分隔的单词进行搜索"/>
			<button name="view_mode_btn" tool_tip="切换其他视图" />
		</layout_panel>
	</layout_stack>
	<button name="collapse_btn" label="收起"/>
	<button name="expand_btn" label="展开" />
	<text name="filter_label" value="过滤器:"/>
