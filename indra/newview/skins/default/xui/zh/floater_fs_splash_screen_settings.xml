<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="splash_screen_settings" title="登录启动画面设置">
	<text name="description">
		在这里配置登录启动画面的显示选项。这些设置将在您下次重新启动查看器时生效。
	</text>
	<text name="section_visibility">
		区域可见性：
	</text>
	<check_box label="隐藏顶部栏" name="hide_top_bar" />
	<check_box label="隐藏博客区域" name="hide_blogs" />
	<check_box label="隐藏目的地" name="hide_destinations" />
	<text name="section_accessibility">
		辅助使用选项：
	</text>
	<check_box label="启用灰度模式" name="use_gray_mode" />
	<check_box label="启用高对比度模式" name="use_high_contrast" />
	<check_box label="启用全大写模式" name="use_all_caps" />
	<check_box label="使用较大字体" name="use_larger_fonts"/>
	<check_box label="关闭透明效果" name="no_transparency" />
</floater>
