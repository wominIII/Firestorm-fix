<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="Scene Load Statistics" title="场景负载统计数据">
	<button label="暂停" name="playpause"/>
	<scroll_container name="statistics_scroll">
		<container_view name="statistics_view">
			<stat_view label="基本" name="basic">
				<stat_bar label="帧像素差" name="frame difference"/>
				<stat_bar label="已收到UDP数据" name="bandwidth"/>
				<stat_bar label="数据包损失" name="packet_loss"/>
			</stat_view>
			<stat_view label="进阶" name="advanced">
				<stat_view label="喧染" name="render">
					<stat_bar label="物件总计" name="objs"/>
					<stat_bar label="新物件" name="newobjs"/>
					<stat_bar label="物件缓存读取率" name="object_cache_hits"/>
				</stat_view>
				<stat_view label="纹理" name="texture">
					<stat_bar label="缓存读取率" name="texture_cache_hits"/>
					<stat_bar label="缓存读取延迟" name="texture_cache_read_latency"/>
					<stat_bar label="缓存解码时间" name="texture_decode_latency" />
					<stat_bar label="缓存写入时间" name="texture_write_latency" />
					<stat_bar label="缓存读取时间" name="texture_fetch_latency" />
					<stat_bar label="缓存获取时间" name="texture_fetch_time" />
					<stat_bar label="计数" name="numimagesstat"/>
					<stat_bar label="原始计数" name="numrawimagesstat"/>
				</stat_view>
				<stat_view label="网络" name="network">
					<stat_bar label="接收数据包" name="packetsinstat"/>
					<stat_bar label="发送数据包" name="packetsoutstat"/>
					<stat_bar label="物件" name="objectdatareceived"/>
					<stat_bar label="纹理" name="texturedatareceived"/>
					<stat_bar label="资源" name="assetudpdatareceived"/>
					<stat_bar label="层次" name="layersdatareceived"/>
					<stat_bar label="实入" name="messagedatain"/>
					<stat_bar label="实出" name="messagedataout"/>
				</stat_view>
			</stat_view>
			<stat_view label="模拟主机(sim)" name="sim">
				<stat_bar label="物件" name="simobjects"/>
				<stat_bar label="使用中物件" name="simactiveobjects"/>
				<stat_bar label="使用中脚本" name="simactivescripts"/>
				<stat_bar label="接收数据包" name="siminpps"/>
				<stat_bar label="发送数据包" name="simoutpps"/>
				<stat_bar label="搁置下载" name="simpendingdownloads"/>
				<stat_bar label="搁置上传" name="simpendinguploads"/>
				<stat_bar label="未承认的总字节数" name="simtotalunackedbytes"/>
				<stat_view label="时间（毫秒）" name="simperf">
					<stat_bar label="总帧时间" name="simframemsec"/>
					<stat_bar label="净时间" name="simnetmsec"/>
					<stat_bar label="物理时间" name="simsimphysicsmsec"/>
					<stat_bar label="仿真时间" name="simsimothermsec"/>
					<stat_bar label="用户时间" name="simagentmsec"/>
					<stat_bar label="图像时间" name="simimagesmsec"/>
					<stat_bar label="脚本时间" name="simscriptmsec"/>
					<stat_bar label="闲置时间" name="simsparemsec"/>
					<stat_view label="时间细节（毫秒）" name="timedetails">
						<stat_bar label="物理步长" name="simsimphysicsstepmsec"/>
						<stat_bar label="更新物理形状" name="simsimphysicsshapeupdatemsec"/>
						<stat_bar label="物理（其他）" name="simsimphysicsothermsec"/>
						<stat_bar label="睡眠时间" name="simsleepmsec"/>
						<stat_bar label="基础网络输出入" name="simpumpiomsec"/>
					</stat_view>
				</stat_view>
			</stat_view>
			<stat_view  name="frame_stats" label="帧分析">
				<stat_bar name="scenery_frame_pct" label="风景"/>
				<stat_bar name="avatar_frame_pct" label="化身"/>
				<stat_bar name="ui_frame_pct" label="用户界面"/>
				<stat_bar name="huds_frame_pct" label="HUD"/>
				<stat_bar name="swap_frame_pct" label="交换"/>
				<stat_bar name="idle_frame_pct" label="空闲"/>
			</stat_view>
		</container_view>
	</scroll_container>
</floater>
