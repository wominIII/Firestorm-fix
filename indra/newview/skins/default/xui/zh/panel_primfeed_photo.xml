<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<panel name="panel_primfeed_photo">
	<combo_box name="resolution_combobox" tool_tip="图片分辨率">
		<combo_box.item label="当前窗口" name="CurrentWindow"/>
		<combo_box.item label="自定义" name="Custom"/>
	</combo_box>
	<combo_box name="filters_combobox" tool_tip="图片滤镜">
		<combo_box.item label="无滤镜" name="NoFilter"/>
	</combo_box>
	<check_box label="保持宽高比" name="keep_aspect_ratio"/>
	<text name="working_lbl">
		正在更新...
	</text>
	<panel name="snapshot_frame_panel">
		<check_box label="显示捕捉框架" tool_tip="在屏幕上显示一个框架，围绕快照区域。场景中超出快照范围的部分将被去饱和并稍微模糊。" name="show_frame"/>
		<check_box label="显示拍摄辅助线" name="show_guides" tool_tip="在取景范围内显示拍摄辅助线（井字构图）。"/>
		<button tool_tip="打开拍摄辅助线设置" name="guide_settings_btn"/>
	</panel>
	<button label="更新" name="new_snapshot_btn" tool_tip="点击更新"/>
	<button label="预览" name="big_preview_btn" tool_tip="点击切换预览状态"/>
	<text name="store_label">
		发布为：
	</text>
	<combo_box name="stores_combobox" tool_tip="如果您在Primfeed上分配了一个或多个EasyBloggers商店，它们将显示在这里。"/>
	<text name="description_label">
		描述：
	</text>
	<panel name="options_panel">
		<check_box label="添加位置描述" name="add_location_cb"/>
		<check_box label="添加到公开图库" name="primfeed_add_to_public_gallery"/>
		<check_box label="商业内容" name="primfeed_commercial_content"/>
		<combo_box name="rating_combobox" tool_tip="Primfeed 内容评级">
			<combo_box.item label="普级" name="GeneralRating"/>
			<combo_box.item label="适度成人" name="ModerateRating"/>
			<combo_box.item label="完全成人" name="AdultRating"/>
			<combo_box.item label="完全成人+" name="AdultPlusRating"/>
		</combo_box>
	</panel>
	<panel name="share_options_panel">
		<check_box label="发布后在浏览器中打开" tool_tip="自动在浏览器中打开Primfeed发布的内容。" name="primfeed_open_url_on_post"/>
		<button label="分享" name="post_photo_btn"/>
		<button label="取消" name="cancel_photo_btn"/>
	</panel>
</panel>