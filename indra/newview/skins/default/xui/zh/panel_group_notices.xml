<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel label="通知" name="notices_tab">
	<panel.string name="help_text">
		通知可让你发送消息并选择性地附上一个附件。
通知仅能传给可接收通知的角色的群组成员。
你可到基本数据选项卡停用通知功能。
	</panel.string>
	<panel.string name="no_notices_text">
		没有过去的通知
	</panel.string>
	<text name="lbl2">
		通知保留 14 天。
每个群组一天最多 200 则
	</text>
	<scroll_list name="notice_list">
		<scroll_list.columns label="主旨" name="subject"/>
		<scroll_list.columns label="发布者" name="from"/>
		<scroll_list.columns label="日期" name="date"/>
	</scroll_list>
	<button label="新通知" name="create_new_notice" tool_tip="创建一个新通知"/>
	<button name="refresh_notices" tool_tip="刷新通知清单。"/>
	<text name="notice_list_none_found">
		没发现。
	</text>
	<panel label="创建新通知" name="panel_create_new_notice">
		<text name="lbl">
			创建一个通知
		</text>
		<text name="lbl3">
			主旨：
		</text>
		<text name="lbl4">
			消息：
		</text>
		<text name="lbl5">
			附件：
		</text>
		<text name="string">
			拖放物件到这里，即可添加为附件：
		</text>
		<button name="remove_attachment" tool_tip="从你的通知移除附件"/>
		<button label="库存" name="open_inventory" tool_tip="开启库存"/>
		<button label="发送" label_selected="发送" name="send_notice"/>
		<group_drop_target name="drop_target" tool_tip="将一个库存物件拖放到这个目标箱框，便可随通知发送该物件。 你必须有权复制并转让此物件，才可以发送它。"/>
	</panel>
	<panel label="查看过去的通知" name="panel_view_past_notice">
		<text name="lbl6">
			存档的通知
		</text>
		<text name="lbl7">
			要发送一个新通知，点击 + 按钮
		</text>
		<text name="lbl8">
			主旨：
		</text>
		<text name="lbl9">
			消息：
		</text>
		<text name="lbl10">
			附件：
		</text>
		<button label="开启附件" name="open_attachment"/>
	</panel>
</panel>
