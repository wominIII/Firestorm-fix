<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="ColorPicker" title="颜色挑选器">
	<tab_container name="scale_type_container">
		<panel name="RGB">
	<text name="r_val_text">
		红色：
	</text>
	<text name="g_val_text">
		绿色：
	</text>
	<text name="b_val_text">
		蓝色：
	</text>
		</panel>
		<panel name="LSL">
	<text name="r_val_text_lsl">
		红色:
	</text>
	<text name="g_val_text_lsl">
		绿色:
	</text>
	<text name="b_val_text_lsl">
		蓝色:
	</text>
		</panel>
		<panel name="Hex">
			<text name="hex_text">
				代码 (#rrggbb):
			</text>
		</panel>
	</tab_container>
	<text name="h_val_text">
		色调：
	</text>
	<text name="s_val_text">
		饱和度：
	</text>
	<text name="l_val_text">
		亮度：
	</text>
	<check_box label="立即应用" name="apply_immediate"/>
	<button label="复制到 LSL" label_selected="复制到 LSL" name="copy_lsl_btn" tool_tip="将颜色代码复制到 LSL 颜色矢量中，格式为 &lt;r, g, b&gt;."/>
	<button label="确定" label_selected="确定" name="select_btn"/>
	<button label="取消" label_selected="取消" name="cancel_btn"/>
	<text name="Current color:">
		当前颜色：
	</text>
	<text name="(Drag below to save.)">
		（拖拽到下方即可保存）
	</text>
</floater>
