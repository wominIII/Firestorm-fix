<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel label="活动" name="panel_ls_events">
	<panel name="panel_ls_input">
		<text name="search_text">
			搜索条件：
		</text>
		<radio_group name="events_search_mode">
			<radio_item label="进行中和即将到来的活动" name="current"/>
			<radio_item label="按日期" name="date"/>
		</radio_group>
		<combo_box name="events_category">
			<combo_box.item label="所有类别" name="any"/>
			<combo_box.item label="论坛" name="discussion"/>
			<combo_box.item label="体育" name="sports"/>
			<combo_box.item label="音乐" name="music"/>
			<combo_box.item label="商业" name="commercial"/>
			<combo_box.item label="俱乐部/娱乐" name="nightlife"/>
			<combo_box.item label="游戏/比赛" name="games"/>
			<combo_box.item label="戏剧" name="pageants"/>
			<combo_box.item label="教育" name="education"/>
			<combo_box.item label="艺术和文化" name="arts"/>
			<combo_box.item label="慈善" name="charity"/>
			<combo_box.item label="其他" name="misc"/>
		</combo_box>
	</panel>
	<panel name="panel_ls_scrolllist">
		<scroll_list name="search_results_events">
			<columns label="活动名称" name="name"/>
			<columns label="日期/时间" name="date"/>
			<columns label="时间" name="time"/>
		</scroll_list>
		<button label="昨天" name="events_yesterday"/>
		<button label="今天" name="events_today"/>
		<button label="明天" name="events_tomorrow"/>
		<button label="上一页" name="events_back"/>
		<button label="下一页" name="events_next"/>
	</panel>
</panel>

