<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_radar">
	<string
		name="MiniMapToolTipMsg"
		value="[REGION]（双击打开地图；按住Shift键并拖动进行平移）"/>
	<string
		name="AltMiniMapToolTipMsg"
		value="[REGION]（双击传送；按住Shift键并拖动进行平移）"/>
	<string name="avatar_name_count" value="名字[[TOTAL]/[IN_REGION]/[IN_CHAT_RANGE]]"/>
	<panel name="nearby_panel">
		<panel name="nearby_buttons_panel">
			<filter_editor label="筛选居民" name="nearby_filter_input"/>
			<button name="gear_btn" tool_tip="对选择的居民执行操作"/>
			<menu_button name="options_btn" tool_tip="雷达选项"/>
			<button name="add_friend_btn" tool_tip="添加到好友列表"/>
		</panel>
		<layout_stack name="radar_outer_ls">
			<layout_panel name="radar_upper_layout">
				<layout_stack name="radar_ls">
					<layout_panel name="radarlayout">
						<radar_list name="radar_list">
							<radar_list.columns label="名字" name="name" tool_tip="[TOTAL]个化身，[IN_REGION]在同一区域， [IN_CHAT_RANGE] 在聊天范围内"/>
							<radar_list.columns tool_tip="正在使用语音" name="voice_level"/>
							<radar_list.columns name="in_region" tool_tip="位于同一区域（绿色）或同一地块（黄绿色）"/>
							<radar_list.columns name="typing_status" tool_tip="正在输入中"/>
							<radar_list.columns name="sitting_status" tool_tip="正在坐着"/>
							<radar_list.columns tool_tip="有支付信息" name="flags"/>
							<radar_list.columns tool_tip="有档案" name="has_notes"/>
							<radar_list.columns label="年龄" width="45" name="age"/>
							<radar_list.columns label="时间" width="45" name="seen"/>
							<radar_list.columns label="距离" width="50" name="range"/>
						</radar_list>
					</layout_panel>
				</layout_stack>
			</layout_panel>
			<layout_panel name="radar_lower_layout">
				<slider label="范围（米）：" name="NearMeRange"/>
			</layout_panel>
		</layout_stack>
	</panel>
</panel>
