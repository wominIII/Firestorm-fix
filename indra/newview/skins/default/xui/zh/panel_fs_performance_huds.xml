<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_performance_huds">
	<text name="back_lbl">
		返回
	</text>
	<text name="huds_title">
		活动的HUD
	</text>
	<text name="huds_desc1">
		移除不需要的HUD可以节省内存并提高查看器的速度。
	</text>
	<text name="huds_desc2">
		HUD经常包含大量脚本，还会产生服务器端的延迟。
	</text>
	<text name="huds_desc3">
		注意: 将HUD最小化的按钮不会将其移除。要移除，请点击“X”。
	</text>
	<name_list name="hud_list">
		<name_list.columns label="时间(微秒)" name="art_value" tool_tip="渲染HUD所需的微秒数。" />
		<name_list.columns label="名称" tool_tip="单击“X”移除HUD。" name="name" />
	</name_list>
</panel>
