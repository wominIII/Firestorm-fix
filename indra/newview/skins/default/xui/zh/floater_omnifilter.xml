<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="omnifilter" title="全方位过滤器规则编辑">
	<layout_stack name="needle_list_stack">
		<layout_panel name="needle_list_layout">
			<check_box name="enable_omnifilter" label="启用全方位过滤器"/>
			<fs_scroll_list name="needle_list">
				<fs_scroll_list.columns name="enabled" label="启用"/>
				<fs_scroll_list.columns name="needle_name" label="规则"/>
			</fs_scroll_list>
			<button name="add_needle" label="添加"/>
			<button name="remove_needle" label="删除"/>
		</layout_panel>
		<layout_panel name="filter_log_layout">
			<fs_scroll_list name="filter_log">
				<fs_scroll_list.columns name="timestamp" label="时间 (SLT)"/>
				<fs_scroll_list.columns name="log_entry" label="规则"/>
			</fs_scroll_list>
		</layout_panel>
	</layout_stack>
	<panel name="panel_details">
		<text name="needle_name_label" value="规则名称:"/>
		<text name="sender_name_label" value="发送者名称:"/>
		<line_editor name="sender_name" tool_tip="消息来源的化身或物件名称" />
		<check_box name="sender_case" tool_tip="区分大小写" />
		<combo_box name="sender_match_type" tool_tip="匹配模式">
			<combo_item name="sender_exact">
				<column name="longtext" label="完全匹配"/>
			</combo_item>
			<combo_item name="sender_substring">
				<column name="longtext" label="部分匹配"/>
			</combo_item>
			<combo_item  name="sender_regex">
				<column name="longtext" label="正则表达式"/>
			</combo_item>
		</combo_box>
		<text name="content_label" value="内容:"/>
		<text_editor name="content" tool_tip="消息的实际文本" />
		<check_box name="content_case" tool_tip="区分大小写" />
		<combo_box name="content_match_type" tool_tip="匹配模式">
			<combo_item name="content_exact">
				<column name="longtext" label="完全匹配"/>
			</combo_item>
			<combo_item name="content_substring">
				<column name="longtext" label="部分匹配"/>
			</combo_item>
			<combo_item name="content_regex">
				<column name="longtext" label="正则表达式"/>
			</combo_item>
		</combo_box>
		<text name="region_name_label" value="区域名称：" tool_tip="来源的区域名称。仅适用于物件接收请求相关功能。"/>
		<line_editor name="region_name" tool_tip="来源的地区名称。仅适用于库存给予。"/>
		<text name="owner_label" value="所有者UUID："/>
		<line_editor name="owner_uuid" tool_tip="群组邀请场景：填写群组UUID&#10;物件聊天消息/所有者消息/调试消息/私聊消息：填写物品UUID&#10;物件私聊消息：填写物件所有者UUID&#10;其他所有场景：填写发送者的UUID"/>
		<text name="match_source_label" value="来源:"/>
		<layout_stack name="buttons_stack">
			<layout_panel name="buttons_group_1">
				<button name="type_nearby" label="本地聊天" tool_tip="来自附近化身的普通聊天消息。"/>
				<button name="type_im" label="私聊" tool_tip="来自居民的私聊消息。"/>
				<button name="type_group_im" label="群组" tool_tip="来自居民的群组消息。"/>
			</layout_panel>
			<layout_panel name="buttons_group_2">
				<button name="type_group_notice" label="通知" tool_tip="群组通知。"/>
				<button name="type_invite" label="邀请" tool_tip="群组邀请。"/>
				<button name="type_object_chat" label="物件聊天消息" tool_tip="来自物件的本地聊天消息。"/>
			</layout_panel>
			<layout_panel name="buttons_group_3">
				<button name="type_object_im" label="物件私聊消息" tool_tip="来自物件的私聊消息。"/>
				<button name="type_script_error" label="错误" tool_tip="脚本的调试消息。"/>
				<button name="type_dialog" label="弹窗" tool_tip="匹配脚本弹窗中的字段。"/>
			</layout_panel>
			<layout_panel name="buttons_group_4">
				<button name="type_inventory_offer" label="接收物件" tool_tip="匹配物件接收请求中的字段。"/>
				<button name="type_friendship" label="好友请求" tool_tip="来自居民的好友请求。"/>
				<button name="type_lure" label="瞬间传送邀请" tool_tip="来自居民的传送邀请。"/>
			</layout_panel>
			<layout_panel name="buttons_group_5">
				<button name="type_tp_request" label="瞬间传送请求" tool_tip="来自居民的瞬间传送请求。"/>
				<button name="type_load_url" label="打开网址" tool_tip="脚本访问网页的请求。"/>
			</layout_panel>
		</layout_stack>
		<text name="chat_replace_label" value="聊天消息替换：" />
		<line_editor name="chat_replace" tool_tip="可用于改变消息显示方式的替换文本" />
		<text name="button_reply_label" value="选择按钮：" />
		<line_editor name="button_reply" tool_tip="要在脚本对话框中“点击”的按钮标签，包括“忽略”" />
		<text name="text_box_reply_label" value="用文本框回复：" />
		<text_editor name="text_box_reply" tool_tip="如同在脚本对话框的文本框中手动输入的回复文本" />
	</panel>
</floater>
