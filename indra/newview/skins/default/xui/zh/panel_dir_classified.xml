<panel label="分类广告" name="panel_dir_classified">
	<string name="searching_text">
		搜索中...
	</string>
	<string name="not_found_text">
		未找到结果。
	</string>
	<string name="found_text">
		找到[COUNT]条结果。
	</string>
	<text name="find">
		输入搜索关键词：
	</text>
	<combo_box name="Category">
		<combo_item name="AnyCategory" label="所有分类"/>
		<combo_item name="Shopping" label="购物"/>
		<combo_item name="LandRental" label="土地租赁"/>
		<combo_item name="PropertyRental" label="房产租赁"/>
		<combo_item name="SpecialAttraction" label="特色景点"/>
		<combo_item name="NewProducts" label="新品"/>
		<combo_item name="Employment" label="招聘"/>
		<combo_item name="Wanted" label="求购"/>
		<combo_item name="Service" label="服务"/>
		<combo_item name="Personal" label="其他"/>
	</combo_box>
	<icon tool_tip="普级" name="rating_icon_general"/>
	<icon tool_tip="适度成人" name="rating_icon_moderate"/>
	<icon tool_tip="完全成人" name="rating_icon_adult"/>
	<scroll_list name="results">
		<column label="名称" name="name" width="215"/>
		<column label="价格" name="price" width="91"/>
	</scroll_list>
	<button tool_tip="上一页" name="prev_btn"/>
	<button tool_tip="下一页" name="next_btn"/>
</panel>