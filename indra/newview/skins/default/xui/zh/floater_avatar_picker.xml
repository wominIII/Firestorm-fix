<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="avatarpicker" title="选择居民">
	<floater.string name="not_found">
		没有查到“[TEXT]”
	</floater.string>
	<floater.string name="not_found_text">
		未发现居民。
	</floater.string>
	<floater.string name="no_one_near">
		附近无人
	</floater.string>
	<floater.string name="no_results">
		没有结果
	</floater.string>
	<floater.string name="searching">
		搜索中...
	</floater.string>
	<string label="确定" label_selected="确定" name="Select">
		选择
	</string>
	<string name="Close">
		关闭
	</string>
	<tab_container name="ResidentChooserTabs">
		<panel label="搜索" name="SearchPanel">
			<text name="InstructSearchResidentName">
				键入人名的一部分：
			</text>
			<button label="查找" label_selected="查找" name="Find"/>
			<fs_scroll_list name="SearchResults">
				<columns label="名称" name="name"/>
				<columns label="用户名" name="username"/>
			</fs_scroll_list>
		</panel>
		<panel label="朋友" name="FriendsPanel">
			<text name="InstructSelectFriend">
				选择一个人：
			</text>
			<fs_scroll_list name="Friends">
				<columns label="名称" name="name"/>
				<columns label="用户名" name="username"/>
			</fs_scroll_list>
		</panel>
		<panel label="附近的人" name="NearMePanel">
			<text name="InstructSelectResident">
				选择一个附近的人：
			</text>
			<slider label="范围" name="near_me_range"/>
			<text name="meters">
				米
			</text>
			<fs_scroll_list name="NearMe">
				<columns label="名称" name="name"/>
				<columns label="用户名" name="username"/>
			</fs_scroll_list>
		</panel>
		<panel label="根据 UUID 搜索" name="SearchPanelUUID">
			<text name="SearchByUUIDLabel">
				输入某人的 UUID：
			</text>
			<button label="查找" label_selected="查找" name="FindUUID"/>
			<fs_scroll_list name="SearchResultsUUID">
				<columns label="名称" name="nameUUID"/>
				<columns label="用户名" name="usernameUUID"/>
			</fs_scroll_list>
		</panel>
		<panel label="联系人分组" name="ContactSetsPanel">
			<text name="SelectContactSetLabel">
				选择一个联系人分组：
			</text>
		</panel>
	</tab_container>
	<button label="确定" label_selected="确定" name="ok_btn"/>
	<button label="取消" label_selected="取消" name="cancel_btn"/>
</floater>
