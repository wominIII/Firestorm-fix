<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="my_environments" title="我的环境">
	<layout_stack name="main_layout">
		<layout_panel label="过滤器" name="filter_panel">
			<check_box label="日循环" name="chk_days"/>
			<check_box label="天空" name="chk_skies"/>
			<check_box label="水文" name="chk_water"/>
			<filter_editor label="过滤环境" name="flt_search"/>
		</layout_panel>
		<layout_panel label="环境" name="list_panel">
			<panel label="pnl_inv_wrap" name="pnl_inv_wrap"/>
		</layout_panel>
		<layout_panel name="lp_showfolders">
			<check_box label="显示所有文件夹" name="chk_showfolders"/>
		</layout_panel>
		<layout_panel name="pnl_control">
			<panel label="bottom_panel" name="pnl_bottom">
				<menu_button name="btn_gear" tool_tip="更多选项"/>
				<menu_button name="btn_newsettings" tool_tip="制作新的环境设置"/>
				<button name="btn_del" tool_tip="移除所选择的物件"/>
			</panel>
		</layout_panel>
	</layout_stack>
</floater>
