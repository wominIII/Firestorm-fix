<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel label="密度" name="panel_settings_sky_density">
	<layout_stack name="main_ls">
		<layout_panel name="lp_1">
			<slider label="瑞利-指数项:" name="rayleigh_exponential"/>
			<slider label="瑞利-指数刻度:" name="rayleigh_exponential_scale"/>
			<slider label="瑞利-线性项:" name="rayleigh_linear"/>
			<slider label="瑞利-常数项:" name="rayleigh_constant"/>
			<slider label="瑞利-最大高度:" name="rayleigh_max_altitude"/>
		</layout_panel>
		<layout_panel name="lp_2">
			<slider label="米氏-指数项:" name="mie_exponential"/>
			<slider label="米氏-指数刻度:" name="mie_exponential_scale"/>
			<slider label="米氏-线性项:" name="mie_linear"/>
			<slider label="米氏-常数项:" name="mie_constant"/>
			<slider label="米氏-各向异性等级:" name="mie_aniso_factor"/>
			<slider label="米氏-最大高度:" name="mie_max_altitude"/>
		</layout_panel>
		<layout_panel name="lp_3">
			<slider label="吸收-指数项:" name="absorption_exponential"/>
			<slider label="吸收-指数刻度:" name="absorption_exponential_scale"/>
			<slider label="吸收-线性项:" name="absorption_linear"/>
			<slider label="吸收-常数项:" name="absorption_constant"/>
			<slider label="吸收-最大高度:" name="absorption_max_altitude"/>
		</layout_panel>
	</layout_stack>
</panel>
