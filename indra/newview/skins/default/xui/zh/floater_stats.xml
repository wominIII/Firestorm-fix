				<stat_bar label="运行脚本" name="simpctscriptsrun"/>
				<stat_bar label="脚本事件" name="simscripteps"/>
				<stat_view label="寻路" name="simpathfinding">
					<stat_bar label="AI时间步长" name="simsimaistepmsec"/>
					<stat_bar label="跳过的剪影步长" name="simsimskippedsilhouettesteps"/>
					<stat_bar label="更新的角色" name="simsimpctsteppedcharacters"/>
				</stat_view>
				<stat_bar label="接收数据包" name="siminpps"/>
				<stat_bar label="发送数据包" name="simoutpps"/>
				<stat_bar label="搁置下载" name="simpendingdownloads"/>
				<stat_bar label="搁置上传" name="simpendinguploads"/>
				<stat_bar label="未确认的总数据" name="simtotalunackedbytes"/>
				<stat_view label="时间" name="simperf">
					<stat_bar label="总帧时间" name="simframemsec"/>
					<stat_bar label="净时间" name="simnetmsec"/>
					<stat_bar label="物理时间" name="simsimphysicsmsec"/>
					<stat_bar label="仿真时间" name="simsimothermsec"/>
					<stat_bar label="用户时间" name="simagentmsec"/>
					<stat_bar label="图像时间" name="simimagesmsec"/>
					<stat_bar label="脚本时间" name="simscriptmsec"/>
					<stat_bar label="闲置时间" name="simsparemsec"/>
					<stat_view label="时间细节" name="timedetails">
						<stat_bar label="物理步长" name="simsimphysicsstepmsec"/>
						<stat_bar label="更新物理形状" name="simsimphysicsshapeupdatemsec"/>
						<stat_bar label="物理（其他）" name="simsimphysicsothermsec"/>
						<stat_bar label="睡眠时间" name="simsleepmsec"/>
						<stat_bar label="IO轮询时间" name="simpumpiomsec"/>
					</stat_view>
				</stat_view>
			</stat_view>
			<stat_view name="voice" label="语音">
				<stat_bar name="webrtc_latency" label="延迟" />
				<stat_bar name="webrtc_upload_bandwidth" label="上传带宽" />
				<stat_view name="incoming_audio" label="传入音频">
					<stat_bar name="incoming_packet_recv" label="已接收数据包" />
					<stat_bar name="packets_in_lost" label="丢失数据包" />
					<stat_bar name="jitter_buffer" label="抖动缓冲区" />
				</stat_view>
				<stat_view name="outgoing_audio" label="传出音频">
					<stat_bar name="packets_out_sent" label="已发送数据包" />
					<stat_bar name="packets_out_lost" label="丢失数据包" />
				</stat_view>
			</stat_view>
		</container_view>
	</scroll_container>
</floater>