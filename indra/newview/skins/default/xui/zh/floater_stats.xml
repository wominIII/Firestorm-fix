					<stat_bar label="帧时间第95百分位" name="framet_95th"/>
					<stat_bar label="帧时间标准差" name="framet_stddev"/>
					<stat_bar label="帧时间事件数" name="framet_events"/>
					<stat_bar label="KTris（每帧）" name="ktrisframe"/>
					<stat_bar label="KTris（每秒）" name="ktrissec"/>
					<stat_bar label="物件总计" name="objs"/>
					<stat_bar label="存入缓存的物件" name="cachedobjs"/>
					<stat_bar label="新物件" name="newobjs"/>
					<stat_bar label="物件缓存读取率" name="object_cache_hits"/>
					<stat_bar label="已运行遮挡查询" name="occlusion_queries"/>
					<stat_bar label="已遮挡物件" name="occluded"/>
					<stat_bar label="未遮挡物件" name="unoccluded"/>
				</stat_view>
				<stat_view label="纹理" name="texture">
					<stat_bar label="缓存读取率" name="texture_cache_hits"/>
					<stat_bar label="缓存读取延迟" name="texture_cache_read_latency"/>
					<stat_bar label="计数" name="numimagesstat"/>
					<stat_bar label="原始数量" name="numrawimagesstat"/>
					<stat_bar label="GL纹理" name="gltexmemstat"/>
					<stat_bar label="格式化内存:" name="formattedmemstat"/>
					<stat_bar label="原始内存" name="rawmemstat"/>
					<stat_bar label="分配内存" name="glboundmemstat"/>
				</stat_view>
				<stat_view name="material" label="材质">
					<stat_bar name="nummaterials" label="数量"/>
				</stat_view>
				<stat_view label="网络" name="network">
					<stat_bar label="接收数据包" name="packetsinstat"/>
					<stat_bar label="发送数据包" name="packetsoutstat"/>
					<stat_bar label="物件" name="objectdatareceived"/>
					<stat_bar label="纹理" name="texturedatareceived"/>
					<stat_bar label="资源" name="assetudpdatareceived"/>
					<stat_bar label="层次" name="layersdatareceived"/>
					<stat_bar label="实入" name="messagedatain"/>
					<stat_bar label="实出" name="messagedataout"/>
				</stat_view>
			</stat_view>
			<stat_view label="模拟主机(sim)" name="sim">
				<stat_bar label="时间膨胀" name="simtimedilation"/>
