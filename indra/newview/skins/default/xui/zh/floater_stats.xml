<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="Statistics" title="统计">
	<scroll_container name="statistics_scroll">
		<container_view name="statistics_view">
			<stat_view label="基本" name="basic">
				<stat_bar label="每秒帧数" name="fps"/>
				<stat_bar label="帧（平均值）" name="frame_mean"/>
				<stat_bar label="帧（中位数）" name="frame_median"/>
				<stat_bar label="抖动" name="framet_jitter"/>
				<stat_bar label="标准会话抖动" name="normalized_cumulative_frametime"/>
				<stat_bar label="归一化周期抖动" name="normalized_period_jitter"/>
				<stat_bar label="归一化帧时间波动" name="normalized_frametime_variation"/>
				<stat_bar label="每分钟帧事件数" name="frame_events_per_minute"/>
				<stat_bar label="最近1分钟帧事件数" name="frame_events_last_minute"/>
				<stat_bar label="接收到的UDP数据" name="bandwidth"/>
				<stat_bar label="数据包损失" name="packet_loss"/>
				<stat_bar label="模拟主机延迟" name="ping"/>
			</stat_view>
			<stat_view label="进阶" name="advanced">
				<stat_view label="喧染" name="render">
					<stat_bar label="累计抖动" name="framet_cumulative"/>
					<stat_bar label="抖动第99百分位" name="framet_jitter_99th"/>
					<stat_bar label="抖动第95百分位" name="framet_jitter_95th"/>
