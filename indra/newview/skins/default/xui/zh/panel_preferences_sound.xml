	<tab_container label="Firestorm 偏好设置" name="tabs">
		<panel label="常规" name="Media Sounds Panel">
			<slider label="主音量" name="System Volume"/>
			<check_box label="最小化时静音" name="mute_when_minimized"/>
			<slider label="界面" name="UI Volume"/>
			<slider label="环境音" name="Wind Volume"/>
			<check_box name="collisions_audio_play_btn" tool_tip="启用此选项以听到碰撞产生的声音" label="启用碰撞声音"/>
			<slider label="音效" name="SFX Volume"/>
			<check_box name="gesture_audio_play_btn" tool_tip="启用此选项以听到居民手势产生的声音" label="启用手势声音"/>
			<slider label="音乐" name="Music Volume"/>
			<check_box label="启用" name="enable_music"/>
			<slider label="媒体" name="Media Volume"/>
			<check_box label="启用" name="enable_media"/>
			<slider label="语音聊天" name="Voice Volume"/>
			<check_box label="启用" name="enable_voice_check_volume"/>
			<text name="Listen media from">
				收听以下媒体和声音：
			</text>
			<radio_group name="media_ear_location">
				<radio_item label="相机位置" name="0"/>
				<radio_item label="化身位置" name="1"/>
			</radio_group>
			<text name="auto_unmute_label">传送后重新启用声音：</text>
			<check_box name="FSAutoUnmuteAmbient" label="环境音" tool_tip="传送后自动重新启用环境声音，如果声音被关闭（默认：关闭）。"/>
			<check_box name="FSAutoUnmuteSounds" label="音效" tool_tip="传送后自动重新启用音效，如果声音被关闭（默认：关闭）"/>
			<text name="friends_logon_sounds_label">当我的朋友：</text>
			<check_box name="friends_notify_online_sound" label="上线"/>
			<check_box name="friends_notify_offline_sound" label="下线"/>
			<text name="money_change_threshold_label" tool_tip="当交易金额超过此处设置的金额时播放声音。">触发交易警告的L$金额：</text>
			<panel name="output_device_settings_panel">
				<panel.string name="output_default_text">默认设备</panel.string>
				<panel.string name="output_no_device">无可用设备</panel.string>
				<panel.string name="output_name_no_device">未知设备</panel.string>
				<panel.string name="output_device_unavailable">设备不可用</panel.string>
				<text name="output_label" width="130">输出设备：</text>
			</panel>
		</panel>
		<panel label="媒体" name="Media Media Panel">
			<text name="media_autoplay_label">自动播放：</text>
			<combo_box name="media_auto_play_combo">
				<item label="禁用" name="autoplay_disabled"/>
				<item label="启用" name="autoplay_enabled"/>
			</combo_box>
			<check_box name="media_allowscript_btn" tool_tip="启用此选项允许物件控制您的多媒体连接" label="允许脚本播放媒体"/>
			<check_box name="media_show_on_others_btn" tool_tip="允许播放附近居民携带的媒体" label="播放居民携带的媒体"/>
			<check_box name="media_huds_autoplay" tool_tip="取消勾选此选项，可使HUD遵循常规媒体的自动播放设置" label="自动播放附着到HUD的媒体" />
			<check_box name="media_filter" tool_tip="启用此选项以对允许或拒绝的媒体设置过滤器" label="启用媒体过滤器"/>
			<button label="管理允许内容" name="edit_media_lists_button"/>
			<text name="media_firstinteract_label" tool_tip="此设置决定哪些媒体在加载后无需首次点击即可交互。这样点击事件会直接传递给媒体，而无需先获取焦点。">
				媒体首次交互：
			</text>
			<check_box name="media_first_click_all" label="物件上的所有媒体"/>
			<check_box name="media_first_click_any" label="任何人的物件"/>
			<check_box name="media_first_click_hud" label="仅穿戴的HUD"/>
			<check_box name="media_first_click_own" label="自己的物件"/>
			<check_box name="media_first_click_group" label="群组物件"/>
			<check_box name="media_first_click_friend" label="朋友的物件"/>
			<check_box name="media_first_click_land" label="土地所有者的物件"/>
			<text name="Media Rolloff">声音衰减启用距离：</text>
			<slider label="开始减弱距离：" name="MediaRollOffMin" tool_tip="音频内容变得不那么明显的距离。"/>
			<text name="MinMeters">米</text>
			<slider label="静音距离：" name="MediaRollOffMax" tool_tip="音频内容将不再被听到的距离。"/>
			<text name="MaxMeters">米</text>
		</panel>
		<panel label="音乐" name="Media Music Panel">
			<check_box name="audio_auto_play_btn" tool_tip="启用此选项以自动播放音乐。" label="允许音乐自动开始"/>
			<check_box name="FSFadeAudioStream" tool_tip="启用此选项在两首音乐之间创建淡入淡出效果" label="启用地块之间的音频淡入淡出："/>
			<slider label="新：" name="FSAudioMusicFadeIn" tool_tip="新音乐的渐入时间。"/>
			<text name="FSAudioMusicFadeInSeconds">秒</text>
			<slider label="旧：" name="FSAudioMusicFadeOut" tool_tip="旧音乐的渐出时间。"/>
			<text name="FSAudioMusicFadeOutSeconds">秒</text>
			<text name="show_stream_metadata_text">显示播放音乐的标题：</text>
			<radio_group name="show_stream_metadata">
				<radio_item label="无" name="radio_off"/>
				<radio_item label="弹出提示" name="radio_toasts"/>
				<radio_item label="本地聊天" name="radio_chat"/>
			</radio_group>
			<check_box name="StreamMetadataAnnounceToChat" label="向频道通告音乐标题："/>
		</panel>
		<panel label="语音聊天" name="Media Voice tab">
			<check_box label="启用语音聊天" name="enable_voice_check"/>
			<button tool_tip="重置设置" name="reset_voice_button"/>
			<radio_group name="ear_location">
				<radio_item label="从相机位置听" name="0"/>
				<radio_item label="从化身位置听" name="1"/>
			<radio_item label="以相同音量收听附近的语音聊天（仅限Opensim）" name="2"/>
			</radio_group>
			<check_box label="我说话时播放化身嘴部动画" name="enable_lip_sync"/>
			<check_box label="在化身上方显示语音指示器" tool_tip="显示语音聊天活动的指示器" name="FSShowVoiceVisualizer"/>
			<check_box label="在我的化身上方显示语音指示器" name="FSShowMyOwnVoiceVisualizer"/>
			<check_box label="显示带点的语音指示器" name="FSShowVoiceVisualizerWithDot" tool_tip="如果启用此选项，语音指示器中的白点将被显示。如果禁用，仅会显示说话时的波浪符号。"/>
			<check_box label="在私人或群组语音聊天中显示语音指示器" tool_tip="在私人或组语音聊天中显示语音聊天活动的指示器和播放嘴部动画" name="Show_Voice_Visualizers_In_Calls"/>
			<check_box label="在聊天选项卡中显示语音状态" tool_tip="在聊天选项卡中显示语音状态指示器" name="FSShowConversationVoiceStateIndicator"/>
			<check_box label="自动拒绝群组语音聊天" name="VoiceCallsRejectGroup"/>
			<check_box label="自动拒绝私人语音聊天" name="VoiceCallsRejectAdHoc"/>
			<check_box label="自动拒绝化身到化身语音通话" name="VoiceCallsRejectP2P"/>
			<check_box label="通过工具栏按钮切换语音开/关" name="push_to_talk_toggle_check" tool_tip="启用此选项后，仅在按下相应键后才会开启麦克风。要保持静音，只需再次按下该键。"/>
			<check_box label="自动增益控制" name="voice_automatic_gain_control"/>
			<check_box label="回声消除" name="enable_echo_cancellation"/>
			<text name="noise_suppression_label">
				噪声抑制：
			</text>
			<combo_box name="noise_suppression_combo">
				<item label="关" name="noise_suppression_none"/>
				<item label="低" name="noise_suppression_low"/>
				<item label="中" name="noise_suppression_moderate"/>
				<item label="高" name="noise_suppression_high"/>
				<item label="最大" name="noise_suppression_max"/>
			</combo_box>
			<button label="音频设备设置" name="device_settings_btn"/>
			<panel label="设备设置" name="device_settings_panel"/>
		</panel>
		<panel label="界面音效" name="UI Sounds tab">
			<text name="textFSExplanation_tab1">您可以在此处修改界面产生的每个声音，并决定是否启用它们。将其 UUID 输入或将鼠标悬停在字段上查看其默认值。</text>
			<filter_editor name="ui_sound_filter" label="选择界面音效" />
			<scroll_list name="ui_sounds_list">
				<column label="音效" name="ui_sound_label" />
				<column label="状态" name="ui_sound_status" />
			</scroll_list>
			<button name="ui_sound_preview" tool_tip="播放此声音。" />
			<button name="ui_sound_default" tool_tip="重置。" />
		</panel>
	</tab_container>
</panel>