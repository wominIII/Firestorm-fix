<panel label="活动" name="panel_dir_events">
	<string name="searching_text">
		搜索中...
	</string>
	<string name="not_found_text">
		未找到结果。
	</string>
	<string name="found_text">
		找到[COUNT]条结果。
	</string>
	<text name="find">
		输入搜索关键词：
	</text>
	<combo_box name="category_combo">
		<combo_item name="All" label="所有分类"/>
		<combo_item name="Discussion" label="讨论"/>
		<combo_item name="Sports" label="体育"/>
		<combo_item name="LiveMusic" label="音乐现场"/>
		<combo_item name="LiveDJ" label="DJ现场"/>
		<combo_item name="Commercial" label="商业"/>
		<combo_item name="Nightlife/Entertainment" label="夜生活/娱乐"/>
		<combo_item name="Games/Contests" label="游戏/比赛"/>
		<combo_item name="Pageants" label="选美比赛"/>
		<combo_item name="Education" label="教育"/>
		<combo_item name="ArtsandCulture" label="艺术与文化"/>
		<combo_item name="Charity/SupportGroups" label="慈善/互助团体"/>
		<combo_item name="Miscellaneous" label="其他"/>
	</combo_box>
	<icon tool_tip="普级" name="rating_icon_general"/>
	<icon tool_tip="适度成人" name="rating_icon_moderate"/>
	<icon tool_tip="完全成人" name="rating_icon_adult"/>
	<scroll_list name="results">
		<column label="名称" name="name" />
		<column label="时间(PT)" name="date"/>
		<column label="时间" name="time" />
	</scroll_list>
	<button tool_tip="上一页" name="prev_btn"/>
	<button tool_tip="下一页" name="next_btn"/>
	<radio_group name="date_mode">
		<radio_item name="current" label="当前及即将开始"/>
		<radio_item name="date" label="日期"/>
	</radio_group>
	<button name="back_btn" tool_tip="后退一天"/>
	<button name="forward_btn" tool_tip="前进一天"/>
</panel>