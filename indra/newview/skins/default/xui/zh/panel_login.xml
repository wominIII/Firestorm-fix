<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel name="panel_login">
	<layout_stack name="main_stack">
		<layout_panel name="center_stage">
			<layout_stack name="ui_stack">
				<layout_panel name="ui_container">
					<combo_box label="用户名" tool_tip="注册时选择的用户名，例如 bobsmith12 或 Steller Sunshine" name="username_combo" />
					<check_box label="记住用户名" name="remember_name" tool_tip="已保存的用户名可在我自己> 偏好设置> 进阶> 记住的用户名中删除。" />
					<line_editor name="password_edit" label="密码" />
					<check_box label="记住密码" name="remember_password" />
					<text name="location_text">
						从这里开始
					</text>
					<combo_box label="我的常用地点" name="start_location_combo">
						<combo_box.item label="我上一次的位置" name="MyLastLocation" />
						<combo_box.item label="我的家" name="MyHome" />
					</combo_box>
					<layout_stack name="login_stack">
						<layout_panel name="grid_panel">
							<text name="grid_text">
								模拟主机
							</text>
							<combo_box label="选择模拟主机" name="server_combo" />
						</layout_panel>
						<layout_panel name="login_panel">
							<button label="登录" name="connect_btn" />
							<text name="forgot_password_text">
								登录遇到问题？
							</text>
							<button label="创建账户" name="sign_btn" />
						</layout_panel>
					</layout_stack>
				</layout_panel>
			</layout_stack>
		</layout_panel>
	</layout_stack>
</panel>