<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel name="panel_login">
	<layout_stack name="ui_stack">
		<layout_panel name="ui_container">
			<combo_box label="用户名" name="username_combo" tool_tip="用户名是你注册时所挑选的，例如 bobsmith12 或 Steller Sunshine"/>
			<line_editor label="密码" name="password_edit"/>
			<combo_box label="收藏夹" name="start_location_combo">
				<combo_box.item label="我上一次的位置" name="MyLastLocation"/>
				<combo_box.item label="我的家" name="MyHome"/>
			</combo_box>
			<button label="登录" name="connect_btn"/>
			<text name="sign_up_text">
				注册
			</text>
			<check_box label="记住我" name="remember_name" tool_tip="可从我自己> 偏好设置> 进阶> 记住的用户名中忘记已记住的用户。"/>
			<check_box label="记住密码" name="remember_password"/>
			<text name="forgot_password_text">
				忘记密码
			</text>
			<combo_box label="选择模拟主机" name="server_combo"/>
		</layout_panel>
	</layout_stack>
</panel>
