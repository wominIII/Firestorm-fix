<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="experience_profile" title="体验">
	<floater.string name="empty_slurl">
		（无）
	</floater.string>
	<text name="edit_title" value="体验预览"/>
	<tab_container name="tab_container">
		<panel name="panel_experience_info">
			<scroll_container name="xp_scroll">
				<panel name="scrolling_panel">
					<layout_stack name="ls1">
						<layout_panel name="top panel">
							<button label="编辑" name="edit_btn"/>
						</layout_panel>
						<layout_panel name="maturity panel">
							<text name="ContentRating">
								分级：
							</text>
						</layout_panel>
						<layout_panel name="location panel">
							<text name="Location">
								位置：
							</text>
						</layout_panel>
						<layout_panel name="marketplace panel">
							<text name="Marketplace">
								市场商店:
							</text>
						</layout_panel>
						<layout_panel name="owner panel">
							<text name="Owner">
								所有者：
							</text>
						</layout_panel>
						<layout_panel name="group_panel">
							<text name="Group">
								群组：
							</text>
						</layout_panel>
						<layout_panel name="perm panel">
							<button label="允许" name="allow_btn"/>
							<button label="遗忘" name="forget_btn"/>
							<button label="封锁" name="block_btn"/>
							<text name="privileged">
								所有居民均可使用这个体验。
							</text>
							<button label="违规举报" name="report_btn"/>
						</layout_panel>
					</layout_stack>
				</panel>
			</scroll_container>
		</panel>
		<panel name="edit_panel_experience_info">
			<scroll_container name="edit_xp_scroll">
				<panel name="edit_scrolling_panel">
					<text name="edit_experience_title_label" value="名称："/>
					<text name="edit_experience_desc_label" value="描述："/>
					<button label="群组" name="Group_btn"/>
					<text name="edit_ContentRating">
						分级：
					</text>
					<icons_combo_box label="适度成人" name="edit_ContentRatingText" tool_tip="提升体验的内容分级将会重置所有已允许该体验的居民的权限。">
						<icons_combo_box.item label="完全成人" name="Adult" value="42"/>
						<icons_combo_box.item label="适度成人" name="Mature" value="21"/>
						<icons_combo_box.item label="普级" name="PG" value="13"/>
					</icons_combo_box>
					<text name="edit_Location">
						位置：
					</text>
					<button label="设置为当前位置" name="location_btn"/>
					<button label="清空位置" name="clear_btn"/>
					<text name="edit_marketplace">
						市场商店:
					</text>
					<check_box label="启用体验" name="edit_enable_btn"/>
					<check_box label="不显现在搜索结果" name="edit_private_btn"/>
					<text name="changes" value="体验的变更结果可能需要数分钟才会扩及所有区域。"/>
					<button label="返回" name="cancel_btn"/>
					<button label="保存" name="save_btn"/>
				</panel>
			</scroll_container>
		</panel>
	</tab_container>
</floater>
