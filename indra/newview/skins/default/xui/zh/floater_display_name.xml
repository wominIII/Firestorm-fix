<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="Display Name" title="变更显示名">
	<floater.string name="LockOutDateFormat">
		[year,datetime,slt] [month,datetime,slt] [day,datetime,slt] [ampm,datetime,slt] [hour,datetime,slt]:[min,datetime,slt]:[second,datetime,slt] [timezone,datetime,slt]
	</floater.string>
	<text name="info_text">
		你为你的化身取的名字叫做“显示名”。 一星期可以修改一次。
	</text>
	<text name="lockout_text">
		你下次能再更改显示名的时间为 [TIME]。
	</text>
	<text name="set_name_label">
		新显示名：
	</text>
	<text name="name_confirm_label">
		再次输入你的新名称以便确认：
	</text>
	<button label="保存" name="save_btn" tool_tip="保存你的新的显示名"/>
	<button label="重置" name="reset_btn" tool_tip="将显示名设成和用户名相同"/>
	<button label="取消" name="cancel_btn"/>
</floater>
