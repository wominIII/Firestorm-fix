<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater name="gltf asset editor">
	<floater.string name="floater_title" value="GLTF 场景编辑器" />
	<floater.string name="scene_title" value="场景" />
	<floater.string name="node_title" value="节点" />
	<floater.string name="mesh_title" value="网格" />
	<floater.string name="skin_title" value="皮肤" />
	<layout_stack name="main_layout">
		<layout_panel name="transforms_panel">
			<menu_button name="clipboard_pos_btn" tool_tip="粘贴选项" />
			<text name="label position" tool_tip="位置（米）">
				位置 (m)
			</text>
			<menu_button name="clipboard_size_btn" tool_tip="粘贴选项" />
			<text name="label size" tool_tip="大小（米）">
				大小 (m)
			</text>
			<menu_button name="clipboard_rot_btn" tool_tip="粘贴选项" />
			<text name="label rotation" tool_tip="旋转（度）">
				旋转 (°)
			</text>
		</layout_panel>
	</layout_stack>
</floater>