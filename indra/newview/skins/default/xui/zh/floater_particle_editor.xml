<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="particle_editor_floater" title="粒子编辑器">
	<panel name="particle_editor_panel">
		<panel name="top_left_panel">
			<text name="Pattern_Label">
				模式：
			</text>

			<combo_box name="pattern_type_combo">
				<combo_box.item label="爆炸" name="explode"/>
				<combo_box.item label="角度" name="angle"/>
				<combo_box.item label="角锥" name="angle_cone"/>
				<combo_box.item label="空心角锥" name="angle_cone_empty"/>
				<combo_box.item label="下落" name="drop"/>
			</combo_box>

			<text name="Texture_Label">
				纹理：
			</text>
			<text name="Burst_Rate_Label">
				爆发速率：
			</text>
			<text name="Burst_Count_Label">
				爆发数量：
			</text>
			<text name="Burst_Radius_Label">
				爆发半径：
			</text>
			<text name="Angle_Begin_Label">
				起始角度：
			</text>
			<text name="Burst_Speed_Min_Label">
				最小爆发速度：
			</text>
			<text name="Angle_End_Label">
				结束角度：
			</text>
			<text name="Burst_Speed_Max_Label">
				最大爆发速度：
			</text>
			<text name="Source_Max_Age_Label">
				最大源头时间：
			</text>
			<text name="Start_Alpha_Label">
				起始透明度：
			</text>
			<text name="Particles_Max_Age_Label">
				最大粒子寿命：
			</text>
			<text name="End_Alpha_Label">
				结束透明度：
			</text>
			<text name="Start_Glow_Label">
				初始光晕：
			</text>
			<combo_box name="blend_func_src_combo">
				<combo_box.item label="混合一" name="blend_one" />
				<combo_box.item label="混合零" name="blend_zero" />
				<combo_box.item label="混合目标颜色" name="blend_dest_color" />
				<combo_box.item label="混合源颜色" name="blend_src_color" />
				<combo_box.item label="混合 1 - 目标颜色" name="blend_one_minus_dest_color" />
				<combo_box.item label="混合 1 - 源颜色" name="blend_one_minus_src_color" />
				<combo_box.item label="混合源透明度" name="blend_src_alpha" />
				<combo_box.item label="混合 1 - 源透明度" name="blend_one_minus_src_alpha" />
			</combo_box>
			<text name="End_Glow_Label">
				结束光晕：
			</text>
			<combo_box name="blend_func_dest_combo">
				<combo_box.item label="混合一" name="blend_one" />
				<combo_box.item label="混合零" name="blend_zero" />
				<combo_box.item label="混合目标颜色" name="blend_dest_color" />
				<combo_box.item label="混合源颜色" name="blend_src_color" />
				<combo_box.item label="混合 1 - 目标颜色" name="blend_one_minus_dest_color" />
				<combo_box.item label="混合 1 - 源颜色" name="blend_one_minus_src_color" />
				<combo_box.item label="混合源透明度" name="blend_src_alpha" />
				<combo_box.item label="混合 1 - 源透明度" name="blend_one_minus_src_alpha" />
			</combo_box>
			<text name="Scale_Start_Label">
				起始大小：
			</text>
			<text name="End_Label">
				结束：
			</text>
		</panel>

		<panel name="top_right_panel">
			<check_box name="bounce_checkbox" label="反弹"/>
			<check_box name="emissive_checkbox" label="自发光"/>
			<check_box name="follow_source_checkbox" label="跟随源"/>
			<check_box name="follow_velocity_checkbox" label="跟随速度"/>
			<check_box name="interpolate_color_checkbox" label="颜色插值"/>
			<check_box name="interpolate_scale_checkbox" label="缩放插值"/>
			<check_box name="target_position_checkbox" label="定位目标"/>
			<check_box name="target_linear_checkbox" label="线性目标"/>
			<check_box name="wind_checkbox" label="被风影响"/>
			<check_box name="ribbon_checkbox" label="带状"/>
			<button name="copy_button" label="复制" tool_tip="复制粒子系统参数为LSL脚本到剪贴板。"/>
			<button name="inject_button" label="注入" tool_tip="将此粒子系统注入到选定的物件中。"/>
		</panel>

		<panel name="bottom_left_panel">
			<text name="Target_Key_Label">
				目标UUID：
			</text>

			<button name="clear_target_button" tool_tip="清除物件或化身作为目标。"/>
			<button name="pick_target_button" tool_tip="点击设置物件或化身作为目标。"/>

			<text name="Acceleration_Label">
				加速度：
			</text>
			<text name="Omega_Label">
				欧米茄：
			</text>
		</panel>

		<panel name="bottom_right_panel">
			<color_swatch label="起始颜色" name="start_color_selector"/>
			<color_swatch label="结束颜色" name="end_color_selector"/>
		</panel>
	</panel>
</floater>

