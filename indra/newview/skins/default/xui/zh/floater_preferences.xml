		<panel label="其他设置" name="input"/>
		<panel label="移动/相机" name="move"/>
		<panel label="按键设置" name="controls"/>
		<panel label="通知" name="msgs"/>
		<panel label="隐私" name="im"/>
		<panel label="进阶" name="advanced1"/>
		<panel label="用户界面" name="ui"/>
		<panel label="皮肤" name="skins"/>
		<panel label="崩溃报告" name="crashreports"/>
		<panel label="Firestorm" name="firestorm"/>
		<panel label="OpenSim" name="opensim"/>
