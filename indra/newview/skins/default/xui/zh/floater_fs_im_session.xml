<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="panel_im">
	<floater.string name="participant_added" value="[NAME] 已被邀请加入聊天。"/>
	<floater.string name="multiple_participants_added" value="[NAME] 已被邀请加入聊天。"/>
	<layout_stack name="ls_control_panel">
		<layout_panel name="gprofile_panel">
			<button name="group_info_btn" tool_tip="显示群组资料"/>
		</layout_panel>
		<layout_panel name="profile_panel">
			<button name="view_profile_btn" tool_tip="显示居民资料"/>
		</layout_panel>
		<layout_panel name="trans_panel">
			<button name="translate_btn" tool_tip="使用配置的服务进行聊天翻译"/>
		</layout_panel>
		<layout_panel name="friend_panel">
			<button name="add_friend_btn" tool_tip="将居民添加为朋友"/>
		</layout_panel>
		<layout_panel name="tp_panel">
			<menu_button name="teleport_btn" tool_tip="提供或请求瞬间传送"/>
		</layout_panel>
		<layout_panel name="share_panel">
			<button name="share_btn" tool_tip="向居民发送物件"/>
		</layout_panel>
		<layout_panel name="pay_panel">
			<button name="pay_btn" tool_tip="向居民发送货币"/>
		</layout_panel>
		<layout_panel name="call_btn_panel">
			<button name="call_btn" tool_tip="使用语音呼叫居民"/>
		</layout_panel>
		<layout_panel name="end_call_btn_panel">
			<button name="end_call_btn" tool_tip="结束呼叫"/>
		</layout_panel>
		<layout_panel name="voice_ctrls_btn_panel">
			<button name="voice_ctrls_btn" tool_tip="呼叫属性"/>
		</layout_panel>
		<layout_panel name="im_history_btn_panel">
			<button name="im_history_btn" tool_tip="打开聊天历史记录"/>
		</layout_panel>
		<layout_panel name="add_participant_panel">
			<button name="add_participant_btn" tool_tip="将某人添加到此聊天"/>
		</layout_panel>
		<layout_panel name="send_sysinfo_btn_panel">
			<button name="send_sysinfo_btn" tool_tip="发送系统信息"/>
		</layout_panel>
		<layout_panel name="lp_options_btn">
			<button name="chat_options_btn" tool_tip="聊天选项"/>
		</layout_panel>
		<layout_panel name="lp_chat_search_btn">
			<button name="chat_search_btn" tool_tip="搜索聊天内容"/>
		</layout_panel>
		<layout_panel name="support_panel">
			<check_box label="发送版本信息" name="FSSupportGroupChatPrefix_toggle" tool_tip="在发送到该群组的每条消息开头添加当前查看器版本、 查看器皮肤、操作系统和 RLVa 状态， 以帮助支持人员更好地诊断可能的问题并提供更准确的答案。"/>
		</layout_panel>
		<layout_panel name="testing_panel">
			<check_box label="发送测试信息" name="FSSupportGroupChatPrefixTesting_toggle" tool_tip="在发送到该群组的每条消息开头添加当前查看器版本、 查看器皮肤、操作系统和 RLVa 状态， 以帮助支持人员更好地诊断可能的问题并提供更准确的答案。（此设置与支持群组无关。）"/>
		</layout_panel>
	</layout_stack>
	<layout_stack name="chat_stack">
		<layout_panel name="panel_im_control_lp">
			<layout_stack name="im_panels">
				<layout_panel name="unread_messages_holder">
					<text name="unread_messages_text">
						未读消息：[NUM]
					</text>
				</layout_panel>
				<layout_panel name="chat_layout_panel">
					<layout_stack name="input_panels">
						<layout_panel name="outgoing_translate_language_layout_panel">
							<combo_box name="outgoing_translate_language" tool_tip="发送翻译目标语言">
								<combo_box.item label="中文" name="zh" value="zh"/>
								<combo_box.item label="英语" name="en" value="en"/>
								<combo_box.item label="日语" name="ja" value="ja"/>
								<combo_box.item label="韩语" name="ko" value="ko"/>
								<combo_box.item label="法语" name="fr" value="fr"/>
								<combo_box.item label="德语" name="de" value="de"/>
								<combo_box.item label="西班牙语" name="es" value="es"/>
								<combo_box.item label="葡萄牙语" name="pt" value="pt"/>
								<combo_box.item label="俄语" name="ru" value="ru"/>
							</combo_box>
						</layout_panel>
						<layout_panel name="outgoing_translate_tone_layout_panel">
							<combo_box name="outgoing_translate_tone" tool_tip="当前会话翻译人格"/>
						</layout_panel>
						<layout_panel name="outgoing_translate_prompt_layout_panel">
							<button name="outgoing_translate_prompt_btn" label="P" tool_tip="编辑当前会话的额外翻译提示词"/>
						</layout_panel>
						<layout_panel name="outgoing_translate_layout_panel">
							<button name="outgoing_translate_btn" label="T" tool_tip="发送消息翻译模式"/>
						</layout_panel>
						<layout_panel name="emoji_button_layout_panel" >
							<button name="emoji_picker_toggle_btn" tool_tip="显示表情符号面板"/>
							<button name="emoji_recent_panel_toggle_btn" tool_tip="显示/隐藏最近使用的表情符号"/>
						</layout_panel>
						<layout_panel name="input_button_layout_panel">
							<button name="send_chat" label="发送" tool_tip="发送这条消息"/>
						</layout_panel>
					</layout_stack>
				</layout_panel>
				<layout_panel name="emoji_recent_layout_panel">
					<text name="emoji_recent_empty_text">
						最近使用过的表情符号将显示在这里
					</text>
				</layout_panel>
			</layout_stack>
		</layout_panel>
	</layout_stack>
</floater>
