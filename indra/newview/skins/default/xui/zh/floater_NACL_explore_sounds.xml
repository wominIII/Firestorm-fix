<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="sound_explorer" title="声音探索器">
	<floater.string name="Playing">
		正在播放
	</floater.string>
	<floater.string name="NotPlaying">
		[TIME] 分钟前
	</floater.string>
	<floater.string name="Type_UI">
		用户界面
	</floater.string>
	<floater.string name="Type_Avatar">
		化身
	</floater.string>
	<check_box name="avatars_chk" label="化身"/>
	<check_box name="objects_chk" label="物件"/>
	<check_box name="collision_chk" label="默认碰撞声音"/>
	<check_box name="repeated_asset_chk" label="重复资产"/>
	<check_box name="pause_chk" label="暂停日志"/>
	<scroll_list name="sound_list">
		<columns label="正在播放" name="playing"/>
		<columns label="类型" name="type"/>
		<columns label="所有者" name="owner"/>
		<columns label="声音" name="sound"/>
	</scroll_list>
	<button label="本地播放" name="play_locally_btn" />
	<button label="本地停止" name="stop_locally_btn" />
	<button label="聚焦" name="look_at_btn" />
	<button label="停止" name="stop_btn"/>
	<button label="封锁名单" name="bl_btn"/>
	<button label="封锁化身所附着物件的声音" name="block_avatar_worn_sounds_btn"/>
	<button label="封锁化身放置物件的声音" name="block_avatar_rezzed_sounds_btn"/>
	<button label="封锁化身播放手势的声音" name="block_avatar_gesture_sounds_btn"/>
</floater>
