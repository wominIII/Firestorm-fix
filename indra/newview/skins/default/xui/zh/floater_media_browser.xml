<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="floater_about" title="媒体刘览器">
	<layout_stack name="stack1">
		<layout_panel name="nav_controls">
			<button label="返回" name="back"/>
			<button label="前进" name="forward"/>
			<button label="重新加载" name="reload"/>
			<button label="前往" name="go"/>
		</layout_panel>
		<layout_panel name="time_controls">
			<button label="后退" name="rewind"/>
			<button label="停止" name="stop"/>
			<button label="前进" name="seek"/>
		</layout_panel>
		<layout_panel name="parcel_owner_controls">
			<button label="发送当前页面到地块" name="assign"/>
		</layout_panel>
		<layout_panel name="external_controls">
			<text name="plugin_fail_text">
媒体浏览器插件正在加载。
如果插件未加载，有关如何解决问题的信息，请访问

https://wiki.firestormviewer.org/fs_media
			</text>
			<button label="用我的浏览器开启" name="open_browser"/>
			<button label="关闭" name="close"/>
		</layout_panel>
	</layout_stack>
</floater>
