<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_snapshot_inventory">
	<text name="title">
		库存
	</text>
	<combo_box label="分辨率" name="texture_size_combo">
		<combo_box.item label="小（128x128）" name="Small(128x128)"/>
		<combo_box.item label="中（256x256）" name="Medium(256x256)"/>
		<combo_box.item label="大（512x512）" name="Large(512x512)"/>
		<combo_box.item label="非常大 (1024x1024)" name="Very Large(1024x1024)"/>
		<combo_box.item label="巨大 (2048x2048)" name="Huge(2048x2048)"/>
		<combo_box.item label="当前窗口" name="CurrentWindow"/>
		<combo_box.item label="自定义" name="Custom"/>
	</combo_box>
	<spinner label="宽 x 高" name="inventory_snapshot_width"/>
	<spinner label="" name="inventory_snapshot_height"/>
	<check_box label="锁定比例" name="inventory_keep_aspect_check"/>
	<text name="hint_lbl">
		若要将图像存为纹理，请选择一个方形格式。

上传费用: [UPLOAD_COST]L$
	</text>
	<button label="&#x25B6; 取消" name="cancel_btn"/>
	<button label="保存" name="save_btn"/>
</panel>
