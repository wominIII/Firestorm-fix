<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="telehub" title="瞬间传送中心">
	<text name="status_text_connected">
		瞬间传送中心已连接物件 [OBJECT]
	</text>
	<text name="status_text_not_connected">
		无连接的瞬间传送中心。
	</text>
	<text name="help_text_connected">
		点击“中断”即可移除。
	</text>
	<text name="help_text_not_connected">
		选择物件，并点击“连接瞬间传送中心”。
	</text>
	<button label="连接瞬间传送中心" name="connect_btn"/>
	<button label="中断" name="disconnect_btn"/>
	<text name="spawn_points_text">
		生成点（位置而非物件）：
	</text>
	<button label="添加生成" name="add_spawn_point_btn"/>
	<button label="移除生成" name="remove_spawn_point_btn"/>
	<text name="spawn_point_help">
		选择物件，并点击“添加生成”来指定位置。
你可以接着移动或删除该物件。
位置是与瞬间传送中心相对。
从菜单中选择一项，在虚拟世界中以高亮显示。
	</text>
</floater>
