<?xml version="1.0" encoding="utf-8"?>
<panel name="panel_login">
	<panel.string name="forgot_password_url">
		http://secondlife.com/account/request.php
	</panel.string>
	<panel.string name="sign_up_url">
		http://join.secondlife.com/
	</panel.string>
	<layout_stack name="logo_stack">
		<layout_panel name="parent_panel2">
			<layout_stack name="widget_stack">
				<layout_panel name="widget_container">
					<combo_box label="用户名" name="username_combo" tool_tip="用户名是你注册时所挑选的，例如 bobsmith12 或 Steller Sunshine"/>
					<line_editor label="密码" name="password_edit"/>
					<button label="登录" name="connect_btn"/>
					<check_box label="记住我" name="remember_check"/>
					<text name="forgot_password_text">
						忘记密码
					</text>
					<text name="sign_up_text">
						注册
					</text>
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="parent_panel3">
			<layout_stack name="images_stack">
				<layout_panel name="images_container">
					<text name="image_caption_left">
						你在“学习岛”的第一步。 找到离开的传送门！
					</text>
					<text name="image_caption_right">
						接着，到“社交岛”探索，认识新的居民朋友！
					</text>
				</layout_panel>
			</layout_stack>
		</layout_panel>
	</layout_stack>
</panel>
