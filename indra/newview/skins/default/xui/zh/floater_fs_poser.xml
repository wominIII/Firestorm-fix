	<layout_stack name="poser_stack">
		<layout_panel name="regular_controls_layout">
			<panel name="joints_parent_panel">
				<tab_container name="joints_tabs">
					<panel title="移动" name="positionRotation_panel">
						<panel name="move_tab_panel">
							<text name="av_position_updown_label">
								上/下：
							</text>
							<slider name="av_position_updown" tool_tip="上下移动选中的化身"/>
							<text name="av_position_leftright_label">
								左/右：
							</text>
							<slider name="av_position_leftright" tool_tip="左右移动选中的化身"/>
							<text name="av_position_inout_label">
								前/后：
							</text>
							<slider name="av_position_inout" tool_tip="前后移动选中的化身"/>
							<check_box name="unlock_pelvis_for_bvh_save_checkbox" label="在BVH中解锁骨盆" tool_tip="将此姿势保存为BVH时，骨盆不会被“锁定”，因此其他动画可移动整个化身。若希望将此姿势叠加播放，请启用此选项。"/>
							<scroll_list name="entireAv_joint_scroll">
								<scroll_list.columns label="身体部位" name="joint"/>
							</scroll_list>
						</panel>
					</panel>
					<panel title="身体" name="body_joints_panel">
						<scroll_list name="body_joints_scroll">
							<scroll_list.columns label="身体部位" name="joint"/>
						</scroll_list>
					</panel>
					<panel title="面部" name="face_joints_panel">
						<scroll_list name="face_joints_scroll">
							<scroll_list.columns label="身体部位" name="joint"/>
						</scroll_list>
					</panel>
					<tab_container title="手" name="hands_tabs">
						<panel title="调整" name="hands_joints_panel">
							<scroll_list name="hand_joints_scroll">
								<scroll_list.columns label="身体部位" name="joint"/>
							</scroll_list>
						</panel>
						<panel title="预设" name="hands_presets_panel">
							<scroll_list name="hand_presets_scroll">
								<scroll_list.columns label="预设名称" name="load_file_name_column"/>
								<scroll_list.columns label="日期" name="load_file_date_column"/>
								<scroll_list.columns label="日期" name="load_file_date_sort_column"/>
							</scroll_list>
							<button label="设置左手" name="button_loadHandPoseLeft" tool_tip="点击将左手设置为选定的预设"/>
							<button label="设置右手" name="button_loadHandPoseRight" tool_tip="点击将右手设置为选定的预设"/>
						</panel>
					</tab_container>
					<panel title="其他" name="misc_joints_panel">
						<scroll_list name="misc_joints_scroll">
							<scroll_list.columns label="身体部位" name="joint"/>
						</scroll_list>
					</panel>
					<panel title="物理" name="collision_volumes_panel">
						<scroll_list name="collision_volumes_scroll">
							<scroll_list.columns label="物理" name="joint"/>
						</scroll_list>
					</panel>
					<panel title="模型" name="avatarSelection_panel">
						<scroll_list tool_tip="选择要制作姿势的化身或动画物件。" name="avatarSelection_scroll">
							<scroll_list.columns label="选择..." name="name"/>
						</scroll_list>
						<button name="refresh_avatars" tool_tip="更新化身和动画物件的列表"/>
						<button label="开始姿势" label_selected="停止姿势" tool_tip="若有权限，开始/停止选定的化身或动画物件的姿势。" name="start_stop_posing_button"/>
						<button label="设为T姿势" tool_tip="点击将选定的化身设为T姿势" name="set_t_pose_button"/>
					</panel>
					<panel title="设置" name="settings_panel">
						<text name="trackpad_sensitivity_label">
							触控板敏感度：
						</text>
						<slider name="trackpad_sensitivity_slider" tool_tip="设置触控板的敏感度"/>
						<check_box name="stop_posing_on_close_checkbox" label="关闭时停止" tool_tip="关闭时不停止姿势可有助于保留当前工作。"/>
						<check_box name="also_save_bvh_checkbox" label="保存时生成BHV" tool_tip="保存姿势时，还会生成一个BHV文件，该文件可通过“建造 > 上传 > 动画”上传，并用于自己的化身或其他化身的姿势。为此，必须将关节的基点设置为零，因为BHV不能从其他姿势派生。"/>
						<check_box name="confirm_overwrite_on_save_checkbox" label="确认覆盖" tool_tip="保存姿势时，如果文件已存在，您需要再次点击保存按钮以确认覆盖。"/>
						<check_box name="natural_direction_checkbox" label="使用自然对齐" tool_tip="骨骼默认具有不自然的关节旋转，这会使姿势调整变得复杂。选中此选项后，关节将以更自然的方式旋转。"/>
						<check_box name="show_joint_markers_checkbox" label="显示关节标记" tool_tip="显示关节标记，以便在姿势编辑时更轻松地选择关节。"/>
						<check_box name="dof_edit_mode_checkbox" label="在编辑模式中启用景深" tool_tip="使用操控器时，景深通常会自动关闭。启用此选项可在编辑姿势或元素时保持景深效果。"/>
					</panel>
				</tab_container>
				<button name="toggleVisualManipulators" tool_tip="启用/禁用可视操控器。" />
			</panel>
			<panel name="joint_manipulation_panel">
				<tab_container name="modifier_tabs">
					<panel label="旋转" name="trackball_panel">
						<fs_virtual_trackpad name="limb_rotation" tool_tip="更改当前选定身体部位的旋转。按住 Ctrl 以缓慢移动。滚动鼠标滚轮以调整三轴。使用 Shift 或 Alt 交换旋转轴的调整方式。" />
						<text name="limb_pitch_label">
							上/下：
						</text>
						<text name="limb_yaw_label">
							左/右：
						</text>
						<text name="limb_roll_label">
							旋转：
						</text>
					</panel>
					<panel title="移动 / 缩放" name="position_panel">
						<text name="pos_x_label">
							位置 X：
						</text>
						<text name="pos_y_label">
							位置 Y：
						</text>
						<text name="pos_z_label">
							位置 Z：
						</text>
						<text name="scale_x_label">
							缩放 X：
						</text>
						<text name="scale_y_label">
							缩放 Y：
						</text>
						<text name="scale_z_label">
							缩放 Z：
						</text>
					</panel>
				</tab_container>
				<panel name="trackball_button_panel">
					<button name="undo_change" tool_tip="撤销上一次公衡"/>
					<button name="button_redo_change" tool_tip="重做上一次变更"/>
					<button name="refresh_avatars" tool_tip="点击将选定的身体部位重置为最初开始调整姿势时的状态"/>
					<button name="delta_mode_toggle" tool_tip="如果改变多个关节，则改变它们相同的值而不是相同的角度。这也用于解决万向节锁定的问题。"/>
					<button name="toggle_LockWorldRotation" tool_tip="锁定所选肢体在全局坐标系下的旋转。被全局锁定的肢体在父肢体移动时仍保持相同的全局旋转。例如：锁定眼睛后转动头部，眼睛仍会（大致）保持原始朝向。"/>
					<button label="镜像" name="button_toggleMirrorRotation" tool_tip="将更改镜像到对侧关节。"/>
					<button label="复制" name="button_toggleSympatheticRotation" tool_tip="将更改复制到对侧关节。"/>
					<button label="W" name="poser_world_frame_toggle" tool_tip="相对于世界执行旋转调整。"/>
					<button label="A" name="poser_avatar_frame_toggle" tool_tip="相对于化身执行旋转调整。"/>
					<button label="B" name="poser_screen_frame_toggle" tool_tip="相对于屏幕执行旋转调整。"/>
					<button label="复制左侧&gt;右" name="button_symmetrize_left_to_right" tool_tip="点击将变更从左侧复制到右侧。" />
					<button label="复制右侧&gt;左" name="button_symmetrize_right_to_left" tool_tip="点击将变更从右侧复制到左侧。" />
				</panel>
			</panel>
			<panel name="poses_loadSave">
				<scroll_list tool_tip="为选定的化身加载姿势。" name="poses_scroll">
					<scroll_list.columns label="名称" name="load_file_name_column"/>
					<scroll_list.columns label="日期" name="load_file_date_column"/>
				</scroll_list>
				<line_editor label="输入姿势保存名称..." name="pose_save_name"/>
			</panel>
		</layout_panel>
		<layout_panel name="button_controls_layout">
			<panel name="button_controls_panel">
				<button name="FlipPose_avatar" tool_tip="左右翻转整个姿势"/>
				<button name="FlipJoint_avatar" tool_tip="镜像翻转选定的身体部位"/>
				<button label="重捕" name="button_RecaptureParts" tool_tip="如果选择的身体部位已关闭，这将重新捕捉这些身体部位当前的姿势。"/>
				<button label="启用/禁用部位" name="toggle_PosingSelectedBones" tool_tip="启用或禁用选定身体部位的姿势。如果禁用，这些部位将正常动画化。"/>
				<button label="自定义姿势" name="toggleLoadSavePanel" tool_tip="加载、保存并管理自定义创建的姿势"/>
				<button tool_tip="管理姿势目录" name="open_poseDir_button"/>
				<menu_button label="加载姿势" tool_tip="加载当前选定的姿势。" name="load_poses_button"/>
				<button label="保存差异" tool_tip="保存与现有姿势的差异。从T姿势开始以创建新作品。" name="save_poses_button"/>
			</panel>
		</layout_panel>
	</layout_stack>
</floater>
