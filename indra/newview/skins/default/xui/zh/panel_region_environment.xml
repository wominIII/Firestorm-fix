<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel label="环境" name="panel_env_info">
	<string name="str_label_use_default">
		使用默认设置
	</string>
	<string name="str_label_use_region">
		使用区域设置
	</string>
	<string name="str_altitude_desription">
		天空 [INDEX]([ALTITUDE]m)
	</string>
	<string name="str_no_parcel">
		未选择地块。 环境设置已停用。
	</string>
	<string name="str_cross_region">
		跨越区域不提供环境设置。
	</string>
	<string name="str_legacy">
		这区域不提供环境设置。
	</string>
	<string name="str_disallowed">
		领地管理人不允许改变此区域的地块环境。
	</string>
	<string name="str_too_small">
		地块必须至少128平方米才可支撑环境。
	</string>
	<string name="str_empty">
		（空白）
	</string>
	<string name="str_region_env">
		（区域环境）
	</string>
	<layout_stack name="ls_main">
		<layout_panel name="pnl_environment_region_msg">
			<text name="region_text_lbl">
				区域：
			</text>
			<text name="region_text">
				未知
			</text>
		</layout_panel>
		<layout_panel name="pnl_environment_disabled">
			<text name="txt_environment_disabled">
				...
			</text>
		</layout_panel>
		<layout_panel name="pnl_environment_config">
			<layout_stack name="ls_environment_config">
				<layout_panel name="pnl_environment_config">
					<layout_stack name="ls_environment_config2">
						<layout_panel name="pnl_environment_current">
							<text name="select_environment_label">
								选择环境
							</text>
							<button label="[USEDEFAULT]" name="btn_usedefault"/>
							<button label="使用库存" name="btn_select_inventory"/>
							<button label="自定义" name="btn_edit"/>
							<check_box label="地块所有者可强制设置环境" name="chk_allow_override"/>
						</layout_panel>
						<layout_panel name="pnl_environment_length">
							<text name="day_settings_label">
								日间设置
							</text>
							<text name="day_length_label">
								日长（小时）
							</text>
							<text name="day_offset_label">
								时差（小时）
							</text>
							<text name="apparent_time_of_day_label">
								可见的一天时间：
							</text>
							<text name="lbl_apparent_time">
								[HH]:[MM][AP] ([PRC]%)
							</text>
						</layout_panel>
					</layout_stack>
				</layout_panel>
				<layout_panel name="pnl_environment_altitudes">
					<panel name="pnl_alt1">
						<text name="txt_alt1">
							天空[INDEX]&#xA;[ALTITUDE]米
						</text>
						<line_editor name="edt_invname_alt1">
							未知
						</line_editor>
						<settings_drop_target name="sdt_alt1" tool_tip="将一个设置从库存拖拽到这个目标箱框，便可把它选定为当前的天空。"/>
					</panel>
					<panel name="pnl_alt2">
						<text name="txt_alt2">
							天空[INDEX]&#xA;[ALTITUDE]米
						</text>
						<line_editor name="edt_invname_alt2">
							未知
						</line_editor>
						<settings_drop_target name="sdt_alt2" tool_tip="将一个设置从库存拖拽到这个目标箱框，便可把它选定为当前的天空。"/>
					</panel>
					<panel name="pnl_alt3">
						<text name="txt_alt3">
							天空[INDEX]&#xA;[ALTITUDE]米
						</text>
						<line_editor name="edt_invname_alt3">
							未知
						</line_editor>
						<settings_drop_target name="sdt_alt3" tool_tip="将一个设置从库存拖拽到这个目标箱框，便可把它选定为当前的天空。"/>
					</panel>
					<text name="sky_altitudes_label">
						天空高度
					</text>
					<panel name="pnl_ground">
						<text name="txt_ground">
							地面
						</text>
						<line_editor name="edt_invname_ground">
							未知
						</line_editor>
						<settings_drop_target name="sdt_ground" tool_tip="将一个设置从库存拖拽到这个目标箱框，便可把它选定为地面水平的天空。"/>
					</panel>
					<panel name="pnl_water">
						<text name="txt_water">
							水文
						</text>
						<line_editor name="edt_invname_water">
							未知
						</line_editor>
						<settings_drop_target name="sdt_water" tool_tip="将一个设置从库存拖拽到这个目标箱框，便可把它选定为当前的水文。"/>
					</panel>
					<button label="重置" name="btn_rst_altitudes" tool_tip="重置为默认高度"/>
				</layout_panel>
			</layout_stack>
		</layout_panel>
	</layout_stack>
</panel>
