<?xml version="1.0" encoding="utf-8"?>
<panel name="panel_flickr_photo">
	<combo_box name="resolution_combobox" tool_tip="图像分辨率">
		<combo_box.item label="当前窗口" name="CurrentWindow"/>
		<combo_box.item label="自定义" name="Custom"/>
	</combo_box>
	<combo_box name="filters_combobox" tool_tip="图像滤镜">
		<combo_box.item label="不用滤镜" name="NoFilter"/>
	</combo_box>
	<check_box label="保持纵横比" name="keep_aspect_ratio"/>
	<text name="working_lbl">
		刷新...
	</text>
	<panel name="options_panel">
		<check_box label="显示捕捉框架" tool_tip="在屏幕上显示一个框架，围绕快照区域。场景中超出快照范围的部分将被去饱和并稍微模糊。" name="show_frame"/>
		<check_box label="显示拍摄辅助线" name="show_guides" tool_tip="在取景范围内显示拍摄辅助线（井字构图）。"/>
		<button tool_tip="打开拍摄辅助线设置" name="guide_settings_btn"/>
	</panel>
	<button label="刷新" name="new_snapshot_btn" tool_tip="点击即可刷新"/>
	<button label="预览" name="big_preview_btn" tool_tip="点击即可切换预览"/>
	<text name="title_label">
		标题：
	</text>
	<text name="description_label">
		描述：
	</text>
	<check_box initial_value="true" label="在描述结尾加上第二人生的地点" name="add_location_cb"/>
	<text name="tags_label" tool_tip="不同标签之间以半角空格, 标签若含空格，用 &quot;&quot; 半角符号括住">
		标签：
	</text>
	<combo_box name="rating_combobox" tool_tip="Flickr 内容分级">
		<combo_box.item label="安全级 Flickr 内容" name="SafeRating"/>
		<combo_box.item label="适中级 Flickr 内容" name="ModerateRating"/>
		<combo_box.item label="限制级 Flickr 内容" name="RestrictedRating"/>
	</combo_box>
	<button label="分享" name="post_photo_btn"/>
	<button label="取消" name="cancel_photo_btn"/>
</panel>
