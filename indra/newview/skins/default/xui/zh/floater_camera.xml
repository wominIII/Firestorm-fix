<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="camera_floater" title="相机控制">
	<floater.string name="rotate_tooltip">
		绕着焦点转动相机
	</floater.string>
	<floater.string name="zoom_tooltip">
		相机移近焦点
	</floater.string>
	<floater.string name="move_tooltip">
		相机上下左右移动
	</floater.string>
	<floater.string name="free_mode_title">
		物件视角
	</floater.string>
	<string name="inactive_combo_text">
		默认值
	</string>
	<panel name="zoom">
		<layout_stack name="camera_view_layout_stack">
			<layout_panel name="camera_rotate_layout_panel">
				<joystick_rotate name="cam_rotate_stick" tool_tip="相机绕焦点旋转"/>
				<button name="roll_left" tool_tip="向左滚动相机"/>
				<button name="roll_right" tool_tip="向右滚动相机"/>
			</layout_panel>
			<layout_panel name="camera_zoom_layout_panel">
				<slider_bar name="zoom_slider" tool_tip="相机移近焦点"/>
			</layout_panel>
			<layout_panel name="panel_track">
				<joystick_track name="cam_track_stick" tool_tip="移动相机上下左右"/>
			</layout_panel>
		</layout_stack>
	</panel>
	<panel name="buttons_panel">
		<panel_camera_item name="front_view" tool_tip="前视图"/>
		<panel_camera_item name="group_view" tool_tip="侧视图"/>
		<panel_camera_item name="rear_view" tool_tip="后视图"/>
		<panel_camera_item name="tpp_view" tool_tip="第三人称视角"/>
		<panel_camera_item name="object_view" tool_tip="物件视图"/>
		<panel_camera_item name="mouselook_view" tool_tip="鼠标观察"/>
		<panel_camera_item name="reset_view" tool_tip="重置视图"/>
	</panel>
	<panel name="preset_buttons_panel">
		<button label="位置..." name="camera_position_btn"/>
		<combo_box name="preset_combo">
			<combo_box.item label="使用预设" name="Use preset"/>
		</combo_box>
		<button name="gear_btn" tool_tip="相机预设"/>
		<button name="save_preset_btn" tool_tip="保存为预设"/>
	</panel>
</floater>
