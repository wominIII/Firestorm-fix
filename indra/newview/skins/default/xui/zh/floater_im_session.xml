<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="panel_im">
	<floater.string name="participant_added" value="[NAME] 已受邀加入聊天。"/>
	<floater.string name="multiple_participants_added" value="[NAME] 已受邀加入聊天。"/>
	<floater.string name="tooltip_to_separate_window" value="为这个聊天另开新窗口"/>
	<floater.string name="tooltip_to_main_window" value="将这个聊天移回到主窗口"/>
	<floater.string name="start_call_button_tooltip" value="创建语音通话"/>
	<floater.string name="end_call_button_tooltip" value="切断语音通话"/>
	<floater.string name="expcol_button_not_tearoff_tooltip" value="收起这个窗口"/>
	<floater.string name="expcol_button_tearoff_and_expanded_tooltip" value="收起参与者清单"/>
	<floater.string name="expcol_button_tearoff_and_collapsed_tooltip" value="展开参与者清单"/>
	<view name="contents_view">
		<layout_stack name="main_stack">
			<layout_panel name="toolbar_panel">
				<menu_button name="view_options_btn" tool_tip="显示/排序选项"/>
				<menu_button name="gear_btn" tool_tip="对选择的人采取操作"/>
				<button name="add_btn" tool_tip="添加某人到聊天"/>
				<button name="voice_call_btn" tool_tip="创建语音通话"/>
				<button name="close_btn" tool_tip="结束该聊天"/>
				<button name="expand_collapse_btn" tool_tip="收起/展开这个窗口"/>
			</layout_panel>
			<layout_panel name="chat_layout_panel">
				<layout_stack name="input_panels">
					<layout_panel name="input_editor_layout_panel"/>
					<layout_panel name="outgoing_translate_language_layout_panel">
						<combo_box name="outgoing_translate_language" tool_tip="发送翻译目标语言">
							<combo_box.item label="中文" name="zh" value="zh"/>
							<combo_box.item label="英语" name="en" value="en"/>
							<combo_box.item label="日语" name="ja" value="ja"/>
							<combo_box.item label="韩语" name="ko" value="ko"/>
							<combo_box.item label="法语" name="fr" value="fr"/>
							<combo_box.item label="德语" name="de" value="de"/>
							<combo_box.item label="西班牙语" name="es" value="es"/>
							<combo_box.item label="葡萄牙语" name="pt" value="pt"/>
							<combo_box.item label="俄语" name="ru" value="ru"/>
						</combo_box>
					</layout_panel>
					<layout_panel name="outgoing_translate_tone_layout_panel">
						<combo_box name="outgoing_translate_tone" tool_tip="当前会话翻译人格"/>
					</layout_panel>
					<layout_panel name="outgoing_translate_prompt_layout_panel">
						<button name="outgoing_translate_prompt_btn" label="P" tool_tip="编辑当前会话的额外翻译提示词"/>
					</layout_panel>
					<layout_panel name="outgoing_translate_layout_panel">
						<button name="outgoing_translate_btn" label="T" tool_tip="发送消息翻译模式"/>
					</layout_panel>
					<layout_panel name="emoji_button_layout_panel">
						<button name="emoji_recent_panel_toggle_btn" tool_tip="显示/隐藏最近使用的表情符号"/>
					</layout_panel>
					<layout_panel name="input_button_layout_panel">
						<button name="minz_btn" tool_tip="显示/隐藏消息窗口"/>
					</layout_panel>
				</layout_stack>
			</layout_panel>
			<layout_panel name="emoji_recent_layout_panel">
				<text name="emoji_recent_empty_text">
					最近使用过的表情符号将显示在这里
				</text>
				<button name="emoji_picker_show_btn" label="更多" tool_tip="显示/隐藏表情符号选择"/>
			</layout_panel>
		</layout_stack>
	</view>
</floater>
