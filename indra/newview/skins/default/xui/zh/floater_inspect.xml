<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="inspect" title="检查物件">
	<floater.string name="timeStampAMPM">
		[year,datetime,slt] [mth,datetime,slt] [day,datetime,slt] [wkday,datetime,slt] [ampm,datetime,slt] [hour12,datetime,slt]:[min,datetime,slt]:[second,datetime,slt]
	</floater.string>
	<floater.string name="timeStamp">
		[year,datetime,slt] [mth,datetime,slt] [day,datetime,slt] [wkday,datetime,slt] [hour,datetime,slt]:[min,datetime,slt]:[second,datetime,slt]
	</floater.string>
	<floater.string name="Group">
		（群组）
	</floater.string>
	<floater.string name="stats_list">
		物件统计：

[NUM_OBJECTS] 个物件，[NUM_PRIMS] 个元素

面数：[NUM_FACES]
可见面数：[NUM_VISIBLE_FACES]
顶点数：[NUM_VERTICES]
三角数：[NUM_TRIANGLES]
复杂度：[COMPLEXITY]

纹理数：[NUM_TEXTURES]
纹理内存：[TEXTURE_MEMORY] KB
显存：[VRAM_USAGE] KB
	</floater.string>
	<text_editor name="linksetstats_text" value="(加载中...)"/>
	<scroll_list name="object_list" tool_tip="从清单中选择一物件，在虚拟世界中加以高亮显示。">
		<scroll_list.columns label="物件名称" name="object_name"/>
		<scroll_list.columns label="描述" name="description"/>
		<scroll_list.columns label="所有者" name="owner_name"/>
		<scroll_list.columns label="创造者" name="creator_name"/>
		<scroll_list.columns label="面数" name="facecount"/>
		<scroll_list.columns label="顶点数" name="vertexcount"/>
		<scroll_list.columns label="三角数" name="trianglecount"/>
		<scroll_list.columns label="纹理内存" name="tramcount"/>
		<scroll_list.columns label="显存" name="vramcount"/>
		<scroll_list.columns label="创造日期" name="creation_date"/>
	</scroll_list>
	<button label="查看所有者档案..." name="button owner" tool_tip="查看高亮显示的物件所有者个人档案"/>
	<button label="查看创造者档案..." name="button creator" tool_tip="查看高亮显示的物件创造者个人档案"/>
	<menu_button name="options_btn" tool_tip="设置"/>
</floater>
