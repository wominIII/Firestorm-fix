	</text>
	<text name="RenderShadowDetailText">
		阴影来源：
	</text>
	<combo_box name="ShadowDetail">
		<combo_box.item label="无" name="0" />
		<combo_box.item label="太阳/月亮" name="1" />
		<combo_box.item label="太阳/月亮 + 投影仪" name="2" />
	</combo_box>
	<text name="water_lbl">
		水文
	</text>
	<text name="water_desc">
