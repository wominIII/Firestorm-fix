<panel label="土地出售" name="panel_dir_land">
	<string name="searching_text">
		搜索中...
	</string>
	<string name="not_found_text">
		未找到结果。
	</string>
	<string name="found_text">
		找到[COUNT]条结果。
	</string>
	<text name="find">
		输入搜索关键词：
	</text>
	<combo_box name="type">
		<combo_item name="AllTypes" label="所有类型"/>
		<combo_item name="Auction" label="拍卖"/>
		<combo_item name="MainlandSales" label="主大陆出售"/>
		<combo_item name="EstateSales" label="领地出售"/>
	</combo_box>
	<icon tool_tip="普级" name="rating_icon_general"/>
	<icon tool_tip="适度成人" name="rating_icon_moderate"/>
	<icon tool_tip="完全成人" name="rating_icon_adult"/>
	<check_box label="价格 &#8804; " name="pricecheck"/>
	<check_box label="面积 &#8805; " name="areacheck"/>
	<text name="areacheck_symbol">
		平方米
	</text>
	<button label="搜索" name="Search"/>
	<scroll_list name="results">
		<column label="名称" name="name" />
		<column label="类型" name="landtype" />
		<column label="L$价格" name="price"/>
		<column label="面积" name="area"/>
		<column label="L$/平方米" name="per_meter"/>
	</scroll_list>
	<button tool_tip="上一页" name="prev_btn"/>
	<button tool_tip="下一页" name="next_btn"/>
</panel>