<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="sell land" title="出售土地">
	<scroll_container name="profile_scroll">
		<panel name="scroll_content_panel">
			<text name="info_parcel_label">
				地块：
			</text>
			<text name="info_parcel">
				地块名称
			</text>
			<text name="info_size_label">
				尺寸：
			</text>
			<text name="info_size">
				[AREA] 平方米
			</text>
			<text name="info_action">
				出售地块：
			</text>
			<text name="price_label">
				1. 设定价格：
			</text>
			<text name="price_text">
				选择适合的价格。
			</text>
			<text name="price_per_m">
				（每平方米 [PER_METER] L$）
			</text>
			<text name="sell_to_label">
				2. 出售土地给：
			</text>
			<text name="sell_to_text">
				选择要卖给任何人或卖给特定买主。
			</text>
			<combo_box name="sell_to">
				<combo_box.item label="- 选择一个 -" name="--selectone--"/>
				<combo_box.item label="任何人" name="Anyone"/>
				<combo_box.item label="指定人：" name="Specificuser:"/>
			</combo_box>
			<button label="选择" name="sell_to_select_agent"/>
			<text name="sell_objects_label">
				3. 物件连同土地一起售出？
			</text>
			<text name="sell_objects_text">
				地块上所有者的可转让物件将过继所有权。
			</text>
			<radio_group name="sell_objects">
				<radio_item label="不，我要保留物件所有权" name="no"/>
				<radio_item label="好，物件连同土地一起售出" name="yes"/>
			</radio_group>
			<button label="显示物件" name="show_objects"/>
			<text name="nag_message_label">
				请记住：售后一概不退。
			</text>
			<button label="设置土地待售" name="sell_btn"/>
			<button label="取消" name="cancel_btn"/>
		</panel>
	</scroll_container>
</floater>
