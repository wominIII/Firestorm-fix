<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="prefs_graphics_advanced" title="进阶显示偏好设置">
	<text name="GeneralText">
		一般
	</text>
	<slider label="描绘距离：" name="DrawDistance"/>
	<text name="DrawDistanceMeterText2">
		米
	</text>
	<slider label="最大粒子效果数量：" name="MaxParticleCount"/>
	<slider label="后处理品质：" name="RenderPostProcess"/>
	<text name="PostProcessText">
		低
	</text>
	<slider label="最大邻近光源数：" name="MaxLights"/>
	<text name="MaxTextureResolutionLabel">
		最大细节层次分辨率：
	</text>
	<combo_box name="MaxTextureResolution" tool_tip="“细节层次(LOD)”纹理的最大分辨率"/>
	<check_box label="启用垂直同步" tool_tip="将帧速率与显示器的刷新率同步，可能会增加卡顿和输入延迟。" name="vsync"/>
	<text name="AvatarText">
		化身
	</text>
	<text name="AvatarComplexityModeLabel">
		化身显示：
	</text>
	<combo_box name="AvatarComplexityMode">
		<combo_box.item label="按复杂度限制" name="0"/>
		<combo_box.item label="优先示好友" name="1"/>
		<combo_box.item label="仅显示好友" name="2"/>
	</combo_box>
	<slider label="最大复杂度：" name="IndirectMaxComplexity" tool_tip="控制在何时下让复杂化身喧染为“果冻娃娃”"/>
	<text name="IndirectMaxComplexityText">
		0
	</text>
	<slider label="动态化身数目上限：" name="IndirectMaxNonImpostors"/>
	<text name="IndirectMaxNonImpostorsText">
		0
	</text>
	<slider label="细节：" name="AvatarMeshDetail"/>
	<text name="AvatarMeshDetailText">
		低
	</text>
	<slider label="身体物理：" name="AvatarPhysicsDetail"/>
	<text name="AvatarPhysicsDetailText">
		低
	</text>
	<text name="HardwareText">
		硬件
	</text>
	<check_box label="各向异性过滤（若启用会变慢）" name="ani"/>
	<check_box initial_value="true" label="启用 OpenGL 顶点缓冲物件(VBO)" name="vbo" tool_tip="在较新硬件上启用，可提升性能。  但是，较旧硬件的 VBO 实作不佳，若启用可能导致当机。"/>
	<check_box initial_value="true" label="启用纹理压缩（须重新启动）" name="texture compression" tool_tip="在显存中压缩纹理，让高分辨率纹理可以加载，但色彩品质稍差。"/>
	<check_box initial_value="true" label="启用HiDPI显示支持（须重新启动）" name="use HiDPI" tool_tip="启用OpenGL高分辨率绘图。"/>
	<text name="antialiasing label">
		抗锯齿：
	</text>
	<combo_box label="抗锯齿" name="fsaa">
		<combo_box.item label="禁用" name="FSAADisabled"/>
		<combo_box.item label="FXAA" name="FXAA"/>
		<combo_box.item label="SMAA" name="SMAA"/>
	</combo_box>
	<text name="antialiasing quality label">
		抗锯齿质量：
	</text>
	<combo_box label="抗锯齿" name="fsaa quality">
		<combo_box.item label="低" name="Low"/>
		<combo_box.item label="中" name="Medium"/>
		<combo_box.item label="高" name="High"/>
		<combo_box.item label="超高" name="Ultra"/>
	</combo_box>
	<text name="MeshText">
		网格模型
	</text>
	<slider label="地形网格细节：" name="TerrainMeshDetail"/>
	<text name="TerrainMeshDetailText">
		低
	</text>
	<slider label="树木：" name="TreeMeshDetail"/>
	<text name="TreeMeshDetailText">
		低
	</text>
	<slider label="物件：" name="ObjectMeshDetail"/>
	<text name="ObjectMeshDetailText">
		低
	</text>
	<slider label="弹性元素：" name="FlexibleMeshDetail"/>
	<text name="FlexibleMeshDetailText">
		低
	</text>
	<text name="antialiasing restart">
		（须重新启动）
	</text>
	<text name="ShadersText">
		着色器
	</text>
	<check_box label="清澈透明的水" name="TransparentWater"/>
	<slider label="天空：" name="SkyMeshDetail"/>
	<text name="SkyMeshDetailText">
		低
	</text>
	<check_box label="环境光遮蔽" name="UseSSAO"/>
	<check_box label="景深" name="UseDoF"/>
	<check_box label="HDR和自发光" name="VintageMode"/>
	<text name="RenderShadowDetailText">
		阴影：
	</text>
	<combo_box name="ShadowDetail">
		<combo_box.item label="无" name="0"/>
		<combo_box.item label="日 / 月" name="1"/>
		<combo_box.item label="日 / 月 + 投影物" name="2"/>
	</combo_box>
	<check_box label="屏幕空间反射" name="ScreenSpaceReflections"/>
	<text name="ReflectionDetailText">
		反射细节:
	</text>
	<combo_box name="ReflectionDetail">
		<combo_box.item label="仅静态" name="0"/>
		<combo_box.item label="静态+动态" name="1"/>
		<combo_box.item label="实时" name="2"/>
	</combo_box>
	<text name="ReflectionProbeText">
			反射覆盖率:
	</text>
	<combo_box name="ReflectionLevel">
		<combo_box.item label="无" name="0"/>
		<combo_box.item label="仅手动" name="1"/>
		<combo_box.item label="手动 + 地形" name="2"/>
		<combo_box.item label="全景" name="3"/>
	</combo_box>
	<text name="ReflectionProbeCount">
		反射探针数量：
	</text>
	<combo_box label="反射探针数量：" name="ProbeCount">
		<combo_box.item label="无" name="1" />
		<combo_box.item label="少量" name="32" />
		<combo_box.item label="中等" name="64" />
		<combo_box.item label="很多" name="128" />
		<combo_box.item label="超多" name="256" />
	</combo_box>
	<slider label="曝光度:" name="RenderExposure"/>
	<check_box label="镜面" name="Mirrors"/>
	<text name="MirrorResolutionText">
		镜面分辨率:
	</text>
	<text name="HeroProbeUpdateText">
		镜面更新频率：
	</text>
	<combo_box name="HeroProbeUpdateRate">
		<combo_box.item label="低" name="6"/>
		<combo_box.item label="中" name="3"/>
		<combo_box.item label="高" name="1"/>
		<combo_box.item label="超高" name="0"/>
	</combo_box>
	<slider label="锐化：" name="RenderSharpness"/>
	<text name="TonemapTypeText">
		色调映射器：
	</text>
	<combo_box name="TonemapType">
		<combo_box.item label="Khronos中性" name="0"/>
		<combo_box.item label="ACES" name="1"/>
	</combo_box>
	<slider label="色调映射混合：" tool_tip="线性和色调映射颜色之间的混合" name="TonemapMix"/>
	<button label="重置为我们建议的设置" name="Defaults"/>
	<button label="确定" label_selected="确定" name="OK"/>
	<button label="取消" label_selected="取消" name="Cancel"/>
	<check_box label="化身最大复杂度" name="RenderAvatarMaxComplexity"/>
	<check_box label="非精简化身最大复杂度" name="RenderAvatarMaxNonImpostors"/>
</floater>
