<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_login">
	<string name="ServerComboTooltip">
		已知的模拟网络或模拟网络URI
	</string>
	<layout_stack name="ui_stack">
		<layout_panel name="ui_container">
			<layout_stack name="vert_stack_left">
				<layout_panel name="1st_row">
					<layout_stack name="1st_row_stack">
						<layout_panel name="login">
							<combo_box name="username_combo" label="用户名" tool_tip="在注册时选择的用户名，例如“berndschmidt12”或“Liebe Sonne”"/>
							<check_box label="保存用户名" name="remember_username_check"/>
						</layout_panel>
						<layout_panel name="delete_container">
							<button tool_tip="删除此用户名" name="remove_user_btn"/>
						</layout_panel>
						<layout_panel name="password_container">
							<line_editor name="password_edit" label="密码"/>
							<check_box label="保存密码" name="remember_check"/>
							<button name="password_show_btn" tool_tip="显示密码文本"/>
							<button name="password_hide_btn" tool_tip="隐藏密码文本"/>
						</layout_panel>
						<layout_panel name="start_location_panel">
							<combo_box name="start_location_combo" label="开始位置:">
								<combo_box.item label="我上一次的位置" name="MyLastLocation"/>
								<combo_box.item label="我的家" name="MyHome"/>
								<combo_box.item label="&lt;请输入区域名称&gt;" name="Typeregionname"/>
							</combo_box>
						</layout_panel>
					</layout_stack>
				</layout_panel>
				<layout_panel name="2nd_row">
					<layout_stack name="2nd_row_stack">
						<layout_panel name="grid_panel">
							<text name="grid_login_text">
								网络:
							</text>
							<text name="grid_builder_text">
								+ 添加更多模拟网格
							</text>
						</layout_panel>
						<layout_panel name="mode_selection">
							<text name="mode_selection_text">
								模式:
							</text>
							<combo_box name="mode_combo" tool_tip="选择您最熟悉的查看器样式，以便根据您的需求进行调整。">
								<combo_box.item label="混合" name="Hybrid"/>
								<combo_box.item label="文本" name="Text"/>
							</combo_box>
						</layout_panel>
					</layout_stack>
				</layout_panel>
			</layout_stack>
			<button label="登录" name="connect_btn"/>
			<text name="create_new_account_text">
				注册新账户
			</text>
			<text name="forgot_password_text">
				忘记密码？
			</text>
		</layout_panel>
	</layout_stack>
</panel>
