<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="item properties" title="物件属性">
	<panel.string name="loading_experience">
		（加载中）
	</panel.string>
	<panel.string name="unknown">
		（未知）
	</panel.string>
	<panel.string name="unknown_multiple">
		（未知 / 多项）
	</panel.string>
	<panel.string name="public">
		（公开）
	</panel.string>
	<panel.string name="you_can">
		你可以：
	</panel.string>
	<panel.string name="owner_can">
		所有者可以：
	</panel.string>
	<panel.string name="acquiredDateAMPM">
		[year,datetime,slt], [mth,datetime,slt] [day,datetime,slt] [wkday,datetime,slt] [ampm,datetime,slt] [hour12,datetime,slt]:[min,datetime,slt]:[second,datetime,slt]
	</panel.string>
	<panel.string name="acquiredDate">
		[year,datetime,slt], [mth,datetime,slt] [day,datetime,slt] [wkday,datetime,slt] [hour,datetime,slt]:[min,datetime,slt]:[second,datetime,slt]
	</panel.string>
	<panel.string name="origin_inventory">
		（库存）
	</panel.string>
	<panel.string name="origin_inworld">
		（在虚拟世界）
	</panel.string>
	<layout_stack name="main_stack">
		<layout_panel name="layout_item_name">
				<line_editor name="LabelItemName" tool_tip="名称限制为63个字符。较长的正式名称将被缩短。名称只能由（非扩展）ASCII-7字符集的可打印字符组成，除了竖线“|”。"/>
		</layout_panel>
		<layout_panel name="layout_item_details">
			<text name="LabelOwnerTitle">
				所有者：
			</text>
			<text name="LabelCreatorTitle">
				创造者：
			</text>
			<text name="LabelAcquiredTitle">
				获取时间：
			</text>
			<button label="图像..." name="change_thumbnail_btn"/>
		</layout_panel>

		<layout_panel name="layout_item_description">
			<text name="LabelItemDescTitle">
				描述：
			</text>
			<line_editor name="LabelItemDesc" tool_tip="在查看器设置中选择“所有物件的悬停提示”选项时，所有物件的描述都会在鼠标指针下的弹出窗口中显示。正式描述限制为127字节，所有更长的字符串将被缩短。"/>
			<text name="LabelItemExperienceTitle">
				体验：
			</text>
		</layout_panel>

		<layout_panel name="layout_item_permissions_sale">
			<text name="perm_modify">
				权限
			</text>
			<text name="you_perm_modify">
				你可以：
			</text>
			<check_box label="修改" name="CheckOwnerModify"/>
			<check_box label="复制" name="CheckOwnerCopy"/>
			<check_box label="转让" name="CheckOwnerTransfer"/>
			<text name="AnyoneLabel">
				任何人：
			</text>
			<check_box label="复制" name="CheckEveryoneCopy" tool_tip="任何人都可取用本物件的副本。 物件和其所有内容都必须允许复制和转让。"/>
			<text name="GroupLabel">
				群组：
			</text>
			<check_box label="分享" name="CheckShareWithGroup" tool_tip="允许此群组所有成员共享你修改此物件的权限。 你必须转让才能启用角色限制。"/>
			<text name="NextOwnerLabel">
				下一个所有者：
			</text>
			<check_box label="修改" name="CheckNextOwnerModify" tool_tip="下一个所有者可以编辑本物件的性质，如名称或尺寸。"/>
			<check_box label="复制" name="CheckNextOwnerCopy" tool_tip="下一个所有者可无限复制本物件。 副本将保留创作人的数据，其允许设置不能比原本物件更加放宽。"/>
			<check_box label="转让" name="CheckNextOwnerTransfer" tool_tip="下一个所有者可赠送或转售这个物件。"/>
			<check_box label="出售" name="CheckPurchase" tool_tip="允许别人在虚拟世界里以特定的价格购买此物件、其内容或其副本。"/>
			<combo_box name="ComboBoxSaleType" tool_tip="决定购买者会收到物件副本、物件内容副本、还是物件本身。">
				<combo_box.item label="复制" name="Copy"/>
				<combo_box.item label="内容" name="Contents"/>
				<combo_box.item label="原件" name="Original"/>
			</combo_box>
			<spinner label="价格： L$" name="Edit Cost" tool_tip="物件成本。"/>
		</layout_panel>

		<layout_panel name="layout_debug_permissions">
			<text name="BaseMaskDebug">
				B:
			</text>
			<text name="OwnerMaskDebug">
				O:
			</text>
			<text name="GroupMaskDebug">
				G:
			</text>
			<text name="EveryoneMaskDebug">
				E:
			</text>
			<text name="NextMaskDebug">
				N:
			</text>
		</layout_panel>
	</layout_stack>
</panel>
