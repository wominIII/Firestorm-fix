<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="fs_camera_floater_small" title="相机控制">
	<floater.string name="rotate_tooltip">
		围绕焦点旋转相机
	</floater.string>
	<floater.string name="zoom_tooltip">
		缩放相机焦点
	</floater.string>
	<floater.string name="move_tooltip">
		移动相机：上、下、左、右
	</floater.string>
	<floater.string name="free_mode_title">
		自由模式：查看物件
	</floater.string>
	<panel name="zoom">
		<layout_stack name="camera_view_layout_stack">
			<layout_panel name="camera_rotate_layout_panel">
				<joystick_rotate name="cam_rotate_stick" tool_tip="围绕焦点旋转相机"/>
				<button name="roll_left" tool_tip="向左滚动摄像头"/>
				<button name="roll_right" tool_tip="向右滚动摄像头"/>
			</layout_panel>
			<layout_panel name="camera_zoom_layout_panel">
				<slider_bar name="zoom_slider" tool_tip="缩放相机焦点"/>
			</layout_panel>
			<layout_panel name="panel_track">
				<joystick_track name="cam_track_stick" tool_tip="上、下、左、右移动相机"/>
			</layout_panel>
		</layout_stack>
	</panel>
	<panel name="buttons_view">
		<panel_camera_item name="front_view" tool_tip="前视图"/>
		<panel_camera_item name="group_view" tool_tip="侧视图"/>
		<panel_camera_item name="rear_view" tool_tip="后视图"/>
		<panel_camera_item name="tpp_view" tool_tip="第三人称视角"/>
	</panel>
	<panel name="buttons">
		<panel_camera_item name="object_view" tool_tip="物件视图"/>
		<panel_camera_item name="mouselook_view" tool_tip="鼠标视图"/>
		<panel_camera_item name="reset_view" tool_tip="重置视图"/>
	</panel>
</floater>
