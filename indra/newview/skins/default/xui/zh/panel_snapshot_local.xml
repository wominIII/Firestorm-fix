<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_snapshot_local">
	<text name="title">
		硬盘
	</text>
	<combo_box label="分辨率" name="local_size_combo">
		<combo_box.item label="当前窗口" name="CurrentWindow"/>
		<combo_box.item label="自定义" name="Custom"/>
	</combo_box>
	<spinner label="宽 x 高" name="local_snapshot_width"/>
	<check_box label="锁定比例" name="local_keep_aspect_check"/>
	<text name="local_format_label">
		格式
	</text>
	<combo_box label="格式" name="local_format_combo">
		<combo_box.item label="PNG（零失真）" name="PNG"/>
		<combo_box.item label="JPEG" name="JPEG"/>
		<combo_box.item label="BMP（零失真）" name="BMP"/>
	</combo_box>
	<slider label="清淅度：" name="image_quality_slider"/>
	<check_box name="local_remember_location_sessions" label="保存位置和文件名"/>
	<check_box name="local_use_timestamp" label="文件名包含日期/时间"/>
	<button label="&#x25B6; 取消" name="cancel_btn"/>
	<flyout_button label="保存" name="save_btn" tool_tip="保存图像到文件">
		<flyout_button.item label="保存" name="save_item"/>
		<flyout_button.item label="另存..." name="saveas_item"/>
	</flyout_button>
</panel>
