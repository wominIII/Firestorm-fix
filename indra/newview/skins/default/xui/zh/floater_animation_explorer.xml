<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="animation_explorer" title="动画-资源管理器">
	<scroll_list name="animation_list">
		<scroll_list.column label="由谁播放" name="played_by" />
		<scroll_list.column label="播放" name="played" />
		<scroll_list.column label="优先级" name="priority" />
		<scroll_list.column label="时间" name="timestamp" />
		<scroll_list.column label="动画-ID" name="animation_id" />
		<scroll_list.column label="物件-ID" name="object_id" />
	</scroll_list>
	<panel name="buttons_panel">
		<button label="停止" name="stop_btn" />
		<button label="停止并重置" name="stop_and_revoke_btn" />
		<button label="封锁名单" name="blacklist_btn" />
		<check_box label="过滤自己的" name="no_owned_animations_check" tool_tip="如果启用，则会过滤自己的化身拥有的所有动画，例如 AO 动画或标准系统动画"/>
	</panel>
</floater>
