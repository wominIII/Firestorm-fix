<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="quickprefs" title="快速设置" width="280">
	<panel name="quickprefs" width="280">
		<layout_stack name="options_stack" width="280"/>
		<layout_stack name="wl_options_stack" width="280">
			<layout_panel name="wl_options_panel">
				<text name="HoverHeightLabel" width="105" tool_tip="设置自己化身的悬浮高度。">
					悬浮高度:
				</text>
				<slider name="HoverHeightSlider"/>
				<text name="Maximum bandwidth" width="105" tool_tip="设置网络使用的最大带宽，单位为Kbps（千比特每秒）。">
					最大带宽:
				</text>
				<slider name="max_bandwidth"/>
				<text name="Maximum complexity" width="105" tool_tip="控制在何时下让复杂化身喧染为“果冻娃娃”">
					最大复杂度:
				</text>
				<slider name="IndirectMaxComplexity" right="-68"/>
				<text name="IndirectMaxComplexityText" width="60">
					无限制
				</text>
				<text name="WL Sky" width="67" tool_tip="天空预设。">
					天空:
				</text>
				<combo_box left_delta="77" name="WLPresetsCombo"/>
				<text name="WL Water" width="67" tool_tip="水面预设。">
					水面:
				</text>
				<combo_box left_delta="77" name="WaterPresetsCombo"/>
				<text name="Day Cycle" width="67" tool_tip="日循环预设。">
					日循环:
				</text>
				<combo_box left_delta="77" name="DCPresetsCombo"/>
				<button name="btn_personal_lighting" label="个人光照" width="227"/>
				<button name="ResetToRegionDefault" tool_tip="将环境设置重置为共享环境。" left="234"/>
				<button name="button_edit" tool_tip="配置快速设置" left="255"/>
			</layout_panel>
		</layout_stack>
	</panel>

	<panel name="edit_overlay_panel">
		<button name="move_up_button" tool_tip="向上移动设置"/>
		<line_editor name="label_edit" tool_tip="显示设置的文本" label="标签:" width="205"/>
		<combo_box name="control_name_combo" tool_tip="从可用设置列表中选择设置" width="245">
			<combo_box.item label="== 选择 ==" name="control_name_list_header"/>
		</combo_box>
		<button name="move_down_button" tool_tip="向下移动设置"/>
		<button name="add_new_button" tool_tip="添加新设置"/>
		<text name="control_type_label">
			类型:
		</text>
		<combo_box name="control_type_combo_box" tool_tip="确定用于此设置的控件类型。" width="148">
			<combo_box.item label="复选框" name="Checkbox"/>
			<combo_box.item label="文本" name="Text"/>
			<combo_box.item label="调节器" name="Spinner"/>
			<combo_box.item label="滑块" name="Slider"/>
			<combo_box.item label="单选按钮" name="Radio"/>
			<combo_box.item label="颜色3" name="Color 3"/>
			<combo_box.item label="颜色4" name="Color 4"/>
		</combo_box>

		<check_box name="control_integer_checkbox" tool_tip="如果设置是整数值，即只有数字没有小数点，则启用" label="整数"/>
		<spinner name="control_min_edit" tool_tip="可以选择的最小值" label="最小:"/>
		<spinner name="control_max_edit" tool_tip="可以选择的最大值" label="最大:"/>
		<spinner name="control_increment_edit" tool_tip="点击调节器的向上或向下箭头时，值增加或减少的步长。" label="步长:" label_width="40" width="90"/>
		<button name="Restore_Btn" tool_tip="恢复默认设置" label="重置" />
		<button name="button_close" tool_tip="结束编辑模式"/>
	</panel>
</floater>
