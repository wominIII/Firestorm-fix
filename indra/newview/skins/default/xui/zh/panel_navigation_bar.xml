<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="navigation_bar">
	<layout_stack name="navigation_favorites_bar_visibility_stack">
		<layout_panel name="navigation_bar_visibility_panel">
			<layout_stack name="location_search_layout">
				<layout_panel name="navigation_buttons_visibility_panel">
					<pull_button name="back_btn" tool_tip="返回上一个位置"/>
					<pull_button name="forward_btn" tool_tip="前往下一个位置"/>
					<button name="home_btn" tool_tip="传送回我的家[LOCATION]"/>
					<button name="About_Land" label="土地" tool_tip="打开土地信息窗口"/>
					<button name="PersonalLighting" label="光照" tool_tip="打开个人光照窗口"/>
				</layout_panel>
				<layout_panel name="location_bar_visibility_panel">
					<location_input label="位置" name="location_combo"/>
				</layout_panel>
				<layout_panel name="search_bar_visibility_panel">
					<search_combo_box label="搜索" name="search_combo_box" tool_tip="搜索">
						<combo_editor label="全球搜索" name="search_combo_editor"/>
					</search_combo_box>
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="favorites_bar_visibility_panel">
			<favorites_bar name="favorite" tool_tip="拖放发送地标到此以便让你能快速传送到在第二人生中你最爱的地点!!">
				<label name="favorites_bar_label" tool_tip="拖放发送地标到此以便让你能快速传送到在第二人生中你最爱的地点!!">
					收藏夹
				</label>
				<chevron_button name="&gt;&gt;" tool_tip="显示更多收藏"/>
			</favorites_bar>
		</layout_panel>
	</layout_stack>
</panel>
