<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<floater name="360capture" title="360° 照片">
	<panel name="ui_panel_left">
		<text name="quality_level_label">
			质量
		</text>
		<radio_group name="360_quality_selection">
			<radio_item label="预览（快速）" name="preview_quality" tool_tip="预览质量"/>
			<radio_item label="中等" name="medium_quality" tool_tip="中等质量"/>
			<radio_item label="高" name="high_quality" tool_tip="高质量"/>
			<radio_item label="最高" name="maximum_quality" tool_tip="最高质量"/>
		</radio_group>
		<check_box label="隐藏所有化身" name="360_hide_avatar"/>
		<button label="生成360°图片" name="capture_button"/>
		<button label="另存为..." name="save_local_button"/>
	</panel>
	<panel name="ui_panel_right">
		<text name="statusbar">
			点击并移动图片以旋转视角。
		</text>
	</panel>
</floater>