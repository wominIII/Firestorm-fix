<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel label="初始化" name="Input panel">
	<tab_container name="tabs" label="初始化">
		<panel label="连接" name="tab-conn">
			<text name="Maximum bandwidth">最大带宽（[https://wiki.firestormviewer.org/fs_speedtest 需要帮助？]）：</text>
			<text name="text_box2">Kbps</text>
			<text name="NetworkPrefText1">Wi-Fi</text>
			<text name="NetworkPrefText2">DSL</text>
			<text name="NetworkPrefText3">光缆</text>
			<text name="NetworkPrefText4">可能有问题</text>
			<check_box label="自定义端口" name="connection_port_enabled"/>
			<spinner label="号码：" name="connection_port"/>
			<text name="Web:">网络浏览器：</text>
			<radio_group name="preferred_browser_behavior">
				<radio_item label="使用我的浏览器（Chrome、Firefox、Edge）打开所有链接" name="new_external" tool_tip="使用系统默认浏览器打开所有链接和帮助。如果您在全屏模式下，不建议使用此选项。"/>
				<radio_item label="仅使用内置浏览器打开Second Life链接" name="new_internal" tool_tip="使用默认浏览器打开帮助和Web链接。仅当涉及到LindenLab/SecondLife链接时才会使用内置浏览器。"/>
				<radio_item label="使用内置浏览器打开所有链接" name="new_internal_all"/>
			</radio_group>
			<text name="numberwebfloaters_label">最大浏览器窗口数：</text>
			<combo_box tool_tip="内置浏览器中可以同时打开的最大浏览器窗口数" name="web_number_combobox">
				<combo_box.item label="无限制" name="web_unlimited"/>
				<combo_box.item label="一个窗口" name="web_1"/>
				<combo_box.item label="五个窗口" name="web_5"/>
				<combo_box.item label="十个窗口" name="web_10"/>
			</combo_box>
			<button label="清除浏览器缓存" name="ClearWebBrowserCache"/>
			<check_box label="接受 Cookies" name="cookies_enabled"/>
			<check_box label="启用 JavaScript" name="browser_javascript_enabled"/>
			<check_box label="在浏览器中启用弹窗" name="media_popup_enabled"/>
			<button label="配置代理设置" label_selected="配置代理设置" name="set_proxy"/>
			<text name="home_page_label_l">浏览器首页：</text>
		</panel>
		<panel label="文件夹" name="tab-dir">
			<text name="cache_size_label_l">缓存大小（[https://wiki.firestormviewer.org/cache 需要帮助？]）：</text>
			<text name="text_box5">mb</text>
			<text name="asset_cache_size_label_l">
				数据资源（资产）缓存：
			</text>
			<text name="asset_text_box5">
				mb
			</text>
			<button label="清除库存缓存" name="ClearInventoryCache" />
			<text name="Cache location">缓存位置：</text>
			<button label="打开" label_selected="打开" name="open_cache"/>
			<button label="设置" width="55" label_selected="设置" name="set_cache"/>
			<button label="重置" width="75" label_selected="重置" name="reset_cache"/>
			<button label="清除" width="45" label_selected="清除" name="clear_cache"/>
			<text name="Sound Cache location">音频缓存位置：</text>
			<button label="打开" label_selected="打开" name="open_sound_cache"/>
			<button label="设置" width="55" label_selected="设置" name="set_sound_cache"/>
			<button label="重置" width="75" label_selected="重置" name="reset_sound_cache"/>
			<check_box label="退出时不删除解压的 DSF（音频）缓存" tool_tip="如果启用，查看器将在退出时不删除解压的缓存声音，从而实现更快的播放。 请注意：启用此选项将快速填满您的缓存，并且不会受到定义的配额限制。这可能导致磁盘使用过量。默认情况下未启用。" name="keep_unpacked_cache"/>
			<text name="log_path_desc">聊天记录与内容的路径：</text>
			<button label="打开" label_selected="打开" name="open_log_path_button-panelsetup"/>
			<button label="设置" label_selected="设置" name="log_path_button-panelsetup"/>
			<button label="重置" label_selected="重置" name="reset_logpath"/>
			<button label="崩溃日志" label_selected="崩溃日志" name="browse_crashlogs"/>
			<button label="设置文件夹" label_selected="设置文件夹" name="browse_settingsdir"/>
		</panel>
	</tab_container>
</panel>