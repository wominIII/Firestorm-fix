<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel label="出入许可" name="Access">
	<tab_container name="tabs">
		<panel label="领地管理员" name="estate_managers_panel">
			<text name="estate_manager_label">
				领地管理员：
			</text>
			<name_list name="estate_manager_name_list">
				<columns label="名称" name="name"/>
			</name_list>
			<button label="添加…" name="add_estate_manager_btn"/>
			<button label="移除…" name="remove_estate_manager_btn"/>
			<button label="导出…" name="export_estate_manager_btn" />
			<button label="导入…" label_selected="导入" name="import_estate_manager_btn" tool_tip="导入仅包含有效UUID的CSV文件——每行一个，无额外字符或格式"/>
		</panel>
		<panel label="获准" name="allowed_panel">
			<panel label="top_panel" name="allowed_search_panel">
				<filter_editor label="搜索获准的用户" name="allowed_search_input"/>
				<button label="复制" name="copy_allowed_list_btn"/>
			</panel>
			<text name="allow_resident_label">
				永远准许：
			</text>
			<name_list name="allowed_avatar_name_list">
				<columns label="名称" name="name"/>
			</name_list>
			<button label="添加…" name="add_allowed_avatar_btn"/>
			<button label="移除…" name="remove_allowed_avatar_btn"/>
			<button label="导出…" name="export_allowed_list_btn" />
			<button label="导入…" label_selected="导入" name="import_allowed_list_btn" tool_tip="导入仅包含有效UUID的CSV文件——每行一个，无额外字符或格式"/>
		</panel>
		<panel label="准许的群组" name="allowed_groups_panel">
			<panel label="top_panel" name="allowed_group_search_panel">
				<filter_editor label="搜索获准的群组" name="allowed_group_search_input"/>
				<button label="复制" name="copy_allowed_group_list_btn"/>
			</panel>
			<text name="allow_group_label">
				永远准许的群组：
			</text>
			<name_list name="allowed_group_name_list">
				<columns label="名称" name="name"/>
			</name_list>
			<button label="添加…" name="add_allowed_group_btn"/>
			<button label="移除…" name="remove_allowed_group_btn"/>
			<button label="导出…" name="export_allowed_group_btn" />
			<button label="导入…" label_selected="导入" name="import_allowed_group_btn" tool_tip="导入仅包含有效UUID的CSV文件——每行一个，无额外字符或格式"/>
		</panel>
		<panel label="禁入的" name="banned_panel">
			<panel label="top_panel" name="banned_search_panel">
				<filter_editor label="搜索禁入的用户" name="banned_search_input"/>
				<button label="复制" name="copy_banned_list_btn"/>
			</panel>
			<text name="ban_resident_label">
				永远禁入：
			</text>
			<name_list name="banned_avatar_name_list">
				<columns label="名称" name="name"/>
				<columns label="上次登录日期" name="last_login_date"/>
				<columns label="遭禁日期" name="ban_date"/>
				<columns label="封锁者：" name="bannedby"/>
			</name_list>
			<button label="添加…" name="add_banned_avatar_btn"/>
			<button label="移除…" name="remove_banned_avatar_btn"/>
			<button label="导出…" name="export_banned_avatar_btn" />
			<button label="导入…" label_selected="导入" name="import_banned_avatar_btn" tool_tip="导入仅包含有效UUID的CSV文件——每行一个，无额外字符或格式"/>
		</panel>
	</tab_container>
</panel>
