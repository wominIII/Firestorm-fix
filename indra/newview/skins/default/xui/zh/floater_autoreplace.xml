<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="autoreplace_floater" title="自动替换设置">
	<check_box label="启用自动替换" name="autoreplace_enable" tool_tip="在输入聊天内容的同时，将输入的关键字代换为相应的替换文本。"/>
	<button label="导入清单…" name="autoreplace_import_list" tool_tip="从文件加载先前导出过的清单。"/>
	<button label="导出清单…" name="autoreplace_export_list" tool_tip="将所选清单保存到文件以便和他人分享。"/>
	<button label="新的清单…" name="autoreplace_new_list" tool_tip="新建一个清单。"/>
	<button label="删除清单" name="autoreplace_delete_list" tool_tip="删除所选清单。"/>
	<button name="autoreplace_list_up" tool_tip="提高此清单的优先次序。"/>
	<button name="autoreplace_list_down" tool_tip="降低此清单的优先次序。"/>
	<scroll_list name="autoreplace_list_replacements">
		<scroll_list.columns label="关键字" name="keyword"/>
		<scroll_list.columns label="替换文本" name="replacement"/>
	</scroll_list>
	<button label="添加..." name="autoreplace_add_entry"/>
	<button label="移除" name="autoreplace_delete_entry"/>
	<text name="autoreplace_keyword_txt">
		关键字：
	</text>
	<text name="autoreplace_replacement_txt">
		替换文本：
	</text>
	<button label="保存项目" name="autoreplace_save_entry" tool_tip="保存此项目。"/>
	<button label="保存变更" name="autoreplace_save_changes" tool_tip="保存所有变更。"/>
	<button label="取消" name="autoreplace_cancel" tool_tip="放弃所有变更。"/>
</floater>
