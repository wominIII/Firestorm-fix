<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Side tray Outfit Edit panel -->
<panel label="编辑装扮" name="outfit_edit">
	<string name="No Outfit" value="无装扮"/>
	<string name="unsaved_changes" value="变更未保存"/>
	<string name="now_editing" value="现在编辑中"/>
	<panel.string name="not_available">
		（不适用）
	</panel.string>
	<panel.string name="unknown">
		（未知）
	</panel.string>
	<string name="Filter.All" value="全部"/>
	<string name="Filter.Clothes/Body" value="服装 / 身体"/>
	<string name="Filter.Objects" value="物件"/>
	<string name="Filter.Clothing" value="服装"/>
	<string name="Filter.Bodyparts" value="身体部位"/>
	<string name="replace_body_part" value="点击以替换你现存的身形"/>
	<text name="title" value="编辑装扮"/>
	<panel name="header_panel">
		<panel name="outfit_name_and_status">
			<text name="status" value="现在编辑中..."/>
			<text name="curr_outfit_name" value="[Current Outfit]"/>
		</panel>
	</panel>
	<layout_stack name="im_panels">
		<layout_panel name="outfit_wearables_panel">
			<layout_stack name="filter_panels">
				<layout_panel name="add_button_and_combobox">
					<button label="添加更多..." name="show_add_wearables_btn" tool_tip="开启 / 关闭"/>
				</layout_panel>
				<layout_panel name="filter_panel">
					<filter_editor label="库存装扮过滤器" name="look_item_filter"/>
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="add_wearables_panel">
			<button label="穿上物件" name="plus_btn"/>
		</layout_panel>
	</layout_stack>
	<panel name="no_add_wearables_button_bar">
		<text name="avatar_complexity_label">
			复杂度：[WEIGHT]
		</text>
		<button name="shop_btn_1" tool_tip="前往第二人生购物市场。 你也可选择你穿戴中的一个物件，再点击这里查看其他同类物件。"/>
	</panel>
	<panel name="add_wearables_button_bar">
		<text name="avatar_complexity_adding_label">
			复杂度：[WEIGHT]
		</text>
		<button name="shop_btn_2" tool_tip="前往第二人生购物市场。 你也可选择你穿戴中的一个物件，再点击这里查看其他同类物件。"/>
	</panel>
	<panel name="save_revert_button_bar">
		<layout_stack name="button_bar_ls">
			<layout_panel name="save_btn_lp">
				<button label="保存" name="save_btn"/>
			</layout_panel>
			<layout_panel name="save_as_btn_lp">
				<button label="另存为" name="save_as_btn" />
			</layout_panel>
			<layout_panel name="revert_btn_lp">
				<button label="复原变更" name="revert_btn" tool_tip="恢复上一个已保存版本"/>
			</layout_panel>
		</layout_stack>
	</panel>
</panel>
