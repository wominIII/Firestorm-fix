<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<llsd>
<map>

	<key>strings</key>
	<map>
		<!-- 主要用于 @showloc 受限时 -->
		<key>hidden_generic</key>
		<map>
			<key>value</key>
			<string>(隐藏)</string>
		</map>
		<key>hidden_parcel</key>
		<map>
			<key>value</key>
			<string>(隐藏地块)</string>
		</map>
		<key>hidden_region</key>
		<map>
			<key>value</key>
			<string>(隐藏区域)</string>
		</map>

		<!-- 当 @recvim/sendim 受限时，接收/发送的即时消息将被替换为匹配的字符串 -->
		<key>blocked_recvim</key>
		<map>
			<key>value</key>
			<string>*** 私聊消息已被您的查看器阻止。</string>
			<key>description</key>
			<string>当一个接收的私聊消息被阻止时，此消息将显示原始消息的位置。</string>
			<key>label</key>
			<string>被阻止的接收的私聊（本地）</string>
			<key>customizable</key>
			<boolean>1</boolean>
		</map>
		<key>blocked_sendim</key>
		<map>
			<key>value</key>
			<string>*** 私聊已被发送者的查看器阻止。</string>
			<key>description</key>
			<string>当一个发送的私聊被阻止时，此消息将显示并发送给接收方。</string>
			<key>label</key>
			<string>被阻止发送的私聊（本地 + 远程）</string>
			<key>customizable</key>
			<boolean>1</boolean>
		</map>

		<!-- 当远程用户发出 @list 或 @except 即时消息查询时发送给他们的信息（如果启用的话） -->
		<key>imquery_list_deny</key>
		<map>
			<key>value</key>
			<string>*** 对方恭敬地请求您不要过问（是兔子逼我这么说的！）</string>
			<key>description</key>
			<string>当您拒绝他们请求列出您的活跃RLV限制时，发送给远程用户的信息</string>
			<key>label</key>
			<string>@list 和 @except 命令（远程）</string>
			<key>customizable</key>
			<boolean>1</boolean>
		</map>

		<!-- 作为 @list 的后缀发送给远程用户，以通知他们可能有更多信息 -->
		<key>imquery_list_suffix</key>
		<map>
			<key>value</key>
			<string>（使用 @except 来查看活跃的例外列表）</string>
			<key>description</key>
			<string>作为 @list 的后缀发送给远程用户，告知他们如何请求您的例外信息</string>
			<key>label</key>
			<string>@list 命令后缀（远程）</string>
			<key>customizable</key>
			<boolean>0</boolean>
		</map>

		<!-- 当远程用户发出 @stopim 即时消息查询时发送给他们的信息（如果启用的话） -->
		<key>stopim_nosession</key>
		<map>
			<key>value</key>
			<string>*** 对方没有受到 @startim 限制</string>
			<key>description</key>
			<string>当他们试图强制关闭与您的私聊会话时（且没有这样的会话存在）发送给远程用户的信息（且没有这样的会话存在）</string>
			<key>label</key>
			<string>@stopim 命令/无会话（远程）</string>
			<key>customizable</key>
			<boolean>1</boolean>
		</map>
		<key>stopim_endsession_remote</key>
		<map>
			<key>value</key>
			<string>*** 已为对方结束会话</string>
			<key>description</key>
			<string>当他们试图强制结束私聊会话时（且会话存在）发送给远程用户的信息</string>
			<key>label</key>
			<string>@stopim 命令/有活跃的会话（远程）</string>
			<key>customizable</key>
			<boolean>1</boolean>
		</map>
		<key>stopim_endsession_local</key>
		<map>
			<key>value</key>
			<string>[NAME] 已经通过 @stopim 远程关闭了私聊会话</string>
		</map>

		<!-- 作为通知显示 -->
		<key>blocked_autopilot</key>
		<map>
			<key>value</key>
			<string>由于RLV限制，无法使用自动寻路功能。</string>
		</map>
		<key>blocked_generic</key>
		<map>
			<key>value</key>
			<string>由于RLV限制，无法执行操作。</string>
		</map>
		<key>blocked_groupchange</key>
		<map>
			<key>value</key>
			<string>由于RLV限制，无法更改活跃群组。重置为 "[GROUP_SLURL]"。</string>
		</map>
		<key>blocked_invfolder</key>
		<map>
			<key>value</key>
			<string>由于RLV锁定文件夹，无法执行所需的库存操作。</string>
		</map>
		<key>blocked_nearby</key>
		<map>
			<key>value</key>
			<string>由于RLV限制，无法显示附近的化身。</string>
		</map>
		<key>blocked_permattach</key>
		<map>
			<key>value</key>
			<string>尝试附着 "[OBJECT]" 由于RLV限制而被拒绝。</string>
		</map>
		<key>blocked_permteleport</key>
		<map>
			<key>value</key>
			<string>"[OBJECT]" 由于RLV限制而被拒绝传送你。</string>
		</map>
		<key>blocked_scriptdialog</key>
		<map>
			<key>value</key>
			<string>由于RLV限制，无法显示脚本弹窗或文本框。</string>
		</map>
		<key>blocked_share</key>
		<map>
			<key>value</key>
			<string>由于RLV限制，无法与 [RECIPIENT] 共享库存。</string>
		</map>
		<key>blocked_share_generic</key>
		<map>
			<key>value</key>
			<string>由于RLV限制，无法共享库存。</string>
		</map>
		<key>blocked_startim</key>
		<map>
			<key>value</key>
			<string>由于RLV限制，无法开始与 [RECIPIENT] 私聊。</string>
		</map>
		<key>blocked_startconf</key>
		<map>
			<key>value</key>
			<string>由于RLV限制，无法开始会议。</string>
		</map>
		<key>blocked_teleport</key>
		<map>
			<key>value</key>
			<string>由于RLV限制，无法启动传送。</string>
		</map>
		<key>blocked_teleport_offer</key>
		<map>
			<key>value</key>
			<string>由于RLV限制，无法提供传送。</string>
		</map>
		<key>blocked_viewxxx</key>
		<map>
			<key>value</key>
			<string>由于RLV限制，无法打开 [TYPE]。</string>
		</map>
		<key>blocked_wireframe</key>
		<map>
			<key>value</key>
			<string>由于RLV限制，无法启用网格线模式。</string>
		</map>

		<!-- 发送给远程用户的“忙碌”消息 -->
		<key>blocked_recvim_remote</key>
		<map>
			<key>value</key>
			<string>您联系的居民目前无法阅读您的私聊，请稍后再试。</string>
			<key>description</key>
			<string>当他们的私聊消息被阻止时发送给远程用户</string>
			<key>label</key>
			<string>被阻止的私聊消息（远程）</string>
			<key>customizable</key>
			<boolean>1</boolean>
		</map>
		<key>blocked_tplurerequest_remote</key>
		<map>
			<key>value</key>
			<string>该居民目前无法接受，请稍后再试。</string>
			<key>description</key>
			<string>当他们的传送邀请或请求被阻止时发送给远程用户</string>
			<key>label</key>
			<string>被阻止的传送邀请/请求（远程）</string>
			<key>customizable</key>
			<boolean>1</boolean>
		</map>
	</map>

	<!-- 当@shownames受限时用于替代居民名字的通用名词 -->
	<key>anonyms</key>
	<array>
