		<string>这位居民</string>
		<string>那位居民</string>
		<string>一位个体</string>
		<string>这位个体</string>
		<string>那位个体</string>
		<string>一个人</string>
		<string>这个人</string>
		<string>那个人</string>
		<string>一个陌生人</string>
		<string>这位陌生人</string>
		<string>那位陌生人</string>
		<string>一个生物</string>
		<string>这个生物</string>
		<string>那个生物</string>
		<string>一个用户</string>
		<string>这个用户</string>
		<string>那个用户</string>
		<string>一个灵魂</string>
		<string>这个灵魂</string>
