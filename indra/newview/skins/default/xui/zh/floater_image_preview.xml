<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="Image Preview">
	<string name="with_alpha" value="有Alpha"/>
	<string name="no_alpha" value="无Alpha"/>
	<text name="name_label">
		名称：
	</text>
	<text name="description_label">
		描述：
	</text>
	<text name="preview_label">
		预览图像为：
	</text>
	<combo_box label="服装类型" name="clothing_type_combo">
		<item label="图像" name="Image"/>
		<item label="头发" name="Hair"/>
		<item label="女性头部" name="FemaleHead"/>
		<item label="女性上半身" name="FemaleUpperBody"/>
		<item label="女性下半身" name="FemaleLowerBody"/>
		<item label="男性头部" name="MaleHead"/>
		<item label="男性上半身" name="MaleUpperBody"/>
		<item label="男性下半身" name="MaleLowerBody"/>
		<item label="裙子" name="Skirt"/>
		<item label="雕刻的元素" name="SculptedPrim"/>
	</combo_box>
	<panel name="image_alpha_warning">
		<check_box name="strip_alpha_check" label="移除空白 Alpha 通道"/>
	</panel>
	<text name="bad_image_text">
		无法读取图像。

请尝试保存图像为 24 比特 Targa（.tga）格式。
	</text>
	<text name="uploaded_size_text">
		上传大小：[X_RES]x[Y_RES], [ALPHA]
	</text>
	<check_box label="使用无损压缩" name="lossless_check"/>
	<check_box name="temp_check" label="临时上传（免费）" tool_tip="免费上传临时图片，但是图片将在一段时间后自动删除。" />
	<button label="上传（[AMOUNT] L$）" name="ok_btn"/>
	<button label="取消" name="cancel_btn"/>
	<text name="info_text" value="= 此处将显示上传费用信息 ="/>
</floater>
