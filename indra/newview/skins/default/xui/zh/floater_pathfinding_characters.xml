<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="floater_pathfinding_characters" title="寻路角色">
	<floater.string name="messaging_get_inprogress">
		寻路角色查找中…
	</floater.string>
	<floater.string name="messaging_get_error">
		查找寻路角色时出错。
	</floater.string>
	<floater.string name="messaging_complete_none_found">
		没有寻路角色。
	</floater.string>
	<floater.string name="messaging_complete_available">
		从 [NUM_TOTAL] 个角色中选择了 [NUM_SELECTED] 个。
	</floater.string>
	<floater.string name="messaging_not_enabled">
		这区域并未启用寻路。
	</floater.string>
	<floater.string name="character_cpu_time">
		[CPU_TIME] 微秒
	</floater.string>
	<floater.string name="character_owner_loading">
		[Loading]
	</floater.string>
	<floater.string name="character_owner_unknown">
		[Unknown]
	</floater.string>
	<floater.string name="character_owner_group">
		[group]
	</floater.string>
	<panel name="pathfinding_chars_main">
		<scroll_list name="objects_scroll_list">
			<scroll_list.columns label="名称" name="name"/>
			<scroll_list.columns label="描述" name="description"/>
			<scroll_list.columns label="所有者" name="owner"/>
			<scroll_list.columns label="CPU" name="cpu_time"/>
			<scroll_list.columns label="高度" name="altitude"/>
		</scroll_list>
		<text name="messaging_status">
			角色：
		</text>
		<button label="刷新清单" name="refresh_objects_list"/>
		<button label="全选" name="select_all_objects"/>
		<button label="全都不选" name="select_none_objects"/>
	</panel>
	<panel name="pathfinding_chars_actions">
		<text name="actions_label">
			对所选角色执行的操作：
		</text>
		<check_box label="显示信标" name="show_beacon"/>
		<check_box label="显示物理胶囊" name="show_physics_capsule"/>
		<button label="获取" name="take_objects"/>
		<button label="拿取副本" name="take_copy_objects"/>
		<button label="瞬间传送我到那里" name="teleport_me_to_object" tool_tip="只在选择了一个角色时启用。"/>
		<button label="退回" name="return_objects"/>
		<button label="删除" name="delete_objects"/>
	</panel>
</floater>
