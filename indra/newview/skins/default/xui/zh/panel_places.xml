<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel label="地点" name="places panel">
	<string name="landmarks_tab_title" value="我的地标"/>
	<string name="teleport_history_tab_title" value="瞬间传送历史纪录"/>
	<string name="favorites_tab_title" value="最爱的"/>

	<layout_stack name="places_layout_panel">
		<layout_panel name="main_panel">
			<layout_stack name="top_menu_panel">
				<layout_panel name="filter_panel">
					<filter_editor label="我的地点过滤器" name="Filter"/>
				</layout_panel>
				<layout_panel name="options_gear_btn_panel">
					<menu_button tool_tip="显示选项" name="options_gear_btn"/>
				</layout_panel>
				<layout_panel name="options_sort_btn_panel">
					<menu_button tool_tip="显示排序选项" name="sorting_menu_btn"/>
				</layout_panel>
				<layout_panel name="add_btn_panel">
					<menu_button name="add_menu_btn" tool_tip="添加新的地标或文件夹"/>
				</layout_panel>
				<layout_panel name="trash_btn_panel" tool_tip="删除选定的地标或文件夹"/>
			</layout_stack>
		</layout_panel>

		<layout_panel name="button_layout_panel">
	<panel name="button_panel">
		<layout_stack name="bottom_bar_ls0">
			<layout_panel name="lp1">
				<layout_stack name="bottom_bar_ls1">
					<layout_panel name="teleport_btn_lp">
						<button label="瞬间传送" name="teleport_btn" tool_tip="瞬间传送到所选的区域"/>
					</layout_panel>
					<layout_panel name="chat_btn_lp">
						<button label="地图" name="map_btn" tool_tip="在世界地图上显示相对应的区域"/>
					</layout_panel>
				</layout_stack>
			</layout_panel>
			<layout_panel name="lp_options">
				<menu_button name="overflow_btn" tool_tip="显示额外选项"/>
			</layout_panel>
			<layout_panel name="lp2">
				<layout_stack name="bottom_bar_profile_ls">
					<layout_panel name="profile_btn_lp">
						<button label="档案" name="profile_btn" tool_tip="显示地点档案"/>
					</layout_panel>
				</layout_stack>
				<layout_stack name="bottom_bar_close_ls3">
					<layout_panel name="close_btn_lp">
						<button label="关闭" name="close_btn"/>
					</layout_panel>
				</layout_stack>
			</layout_panel>
		</layout_stack>
		<layout_stack name="bottom_bar_ls2">
			<layout_panel name="save_btn_lp">
				<button label="保存" name="save_btn"/>
			</layout_panel>
			<layout_panel name="cancel_btn_lp">
				<button label="取消" name="cancel_btn"/>
			</layout_panel>
		</layout_stack>
	</panel>
	</layout_panel>
	</layout_stack>
</panel>
