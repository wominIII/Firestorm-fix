<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="area_search" title="周边区域搜索">
	<tab_container name="area_searchtab">
		<panel name="area_search_list_panel" label="列表">
			<panel.string name="ListedPendingTotalBlank">
				已列出 | 待处理 | 总计
			</panel.string>
			<panel.string name="ListedPendingTotalFilled">
				[LISTED] 已列出 | [PENDING] 待处理 | [TOTAL] 总计
			</panel.string>
			<fs_scroll_list name="result_list">
				<fs_scroll_list.columns name="distance" label="距离" width="50" tool_tip="从化身到物件的距离。"/>
				<fs_scroll_list.columns name="name" label="名称" width="150"/>
				<fs_scroll_list.columns name="description" label="描述" width="150"/>
				<fs_scroll_list.columns name="price" label="价格" width="50" tool_tip="物件的价格，如果正在出售。"/>
				<fs_scroll_list.columns name="land_impact" label="土地影响" width="70" tool_tip="会与地块的元素最大限制进行计算。"/>
				<fs_scroll_list.columns name="prim_count" label="元素" width="50" tool_tip="组成物件的元素数量。"/>
				<fs_scroll_list.columns name="owner" label="所有者" width="90"/>
				<fs_scroll_list.columns name="group" label="群组" width="90" tool_tip="物件所属的群组。"/>
				<fs_scroll_list.columns name="creator" label="创造者" width="90"/>
				<fs_scroll_list.columns name="last_owner" label="前所有者" width="90" tool_tip="物件的上一个所有者。"/>
			</fs_scroll_list>
			<button name="Refresh" label="刷新"/>
			<text name="counter" left_delta="110">
				已列出 | 待处理 | 总计
			</text>
			<check_box name="beacons" label="显示信标"/>
		</panel>
		<panel label="搜索" name="area_search_find_panel">
			<text name="name_label">
				名称：
			</text>
			<text name="desc_label">
				描述：
			</text>
			<text name="owner_label">
				所有者：
			</text>
			<text name="group_label">
				群组：
			</text>
			<text name="creator_label">
				创造者：
			</text>
			<text name="last_owner_label">
				其所有者：
			</text>
			<check_box name="regular_expression" label="使用正则表达式"/>
			<button name="search" label="搜索"/>
			<button name="find_gift_boxes" label="查找礼物盒" tool_tip="在当前地块中查找名称或描述含有礼物关键词的已加载物件，并显示世界信标。"/>
			<button name="clear" label="移除"/>
			<button name="copy_link" label="复制为链接" tool_tip="复制 secondlife:///app/openfloater/area_search?... 链接，用于重现当前的搜索条件和筛选设置。"/>
		</panel>
		<panel label="过滤" name="area_search_filter_panel">
			<text name="only_list">
				仅显示以下属性的物件：
			</text>
			<check_box name="filter_locked" label="锁定"/>
			<check_box name="filter_physical" label="物理"/>
			<check_box name="filter_phantom" label="虚像"/>
			<check_box name="filter_temporary" label="临时"/>
			<check_box name="filter_attachment" label="附件"/>
			<check_box name="filter_moap" label="共享媒体"/>
			<check_box name="filter_perm_copy" label="可复制"/>
			<check_box name="filter_perm_modify" label="可修改"/>
			<check_box name="filter_perm_transfer" label="可转让"/>
			<check_box name="filter_reflection_probe" label="反射探针" tool_tip="仅包含手动探针，不包括自动探针。仅在显示设置中启用镜面时才包含镜面探针。如果反射范围设置为“无”或者探针未烘焙，则可能无法识别物件。"/>
			<check_box name="filter_for_sale" label="出售价格介于"/>
			<text name="and">
				和
			</text>
			<text name="mouse_text">
				鼠标点击操作
			</text>
			<combo_box name="click_action" tool_tip="点击物件执行的操作。">
				<combo_box.item label=" " name="click_blank"/>
				<combo_box.item label="任意" name="click_any"/>
				<combo_box.item label="触碰" name="click_touch"/>
				<combo_box.item label="坐下" name="click_sit"/>
				<combo_box.item label="购买" name="click_buy"/>
				<combo_box.item label="支付" name="click_pay"/>
				<combo_box.item label="打开" name="click_open"/>
				<combo_box.item label="播放" name="click_play"/>
				<combo_box.item label="打开媒体" name="click_open_media"/>
				<combo_box.item label="缩放" name="click_zoom"/>
			</combo_box>
			<check_box name="filter_distance" label="距离介于"/>
			<text name="and2">
				和
			</text>
			<check_box name="filter_agent_parcel_only" label="仅限当前地块"/>
			<text name="only_list">
				排除具有以下属性的物件：
			</text>
			<check_box name="exclude_attachment" label="附件"/>
			<check_box name="exclude_physical" label="物理"/>
			<check_box name="exclude_temporary" label="临时"/>
			<check_box name="exclude_reflection_probes" label="反射探针"/>
			<check_box name="exclude_childprim" label="子元素"/>
			<check_box name="exclude_neighbor_region" label="邻近地块"/>
			<button name="apply" label="应用"/>
			<button name="save_as_default" label="保存为默认"/>
		</panel>
		<panel label="选项" name="area_search_options_panel">
			<text name="display_column">
				显示列：
			</text>
			<check_box name="show_distance" label="距离"/>
			<check_box name="show_name" label="名称"/>
			<check_box name="show_description" label="描述"/>
			<check_box name="show_price" label="价格"/>
			<check_box name="show_land_impact" label="土地影响"/>
			<check_box name="show_prim_count" label="元素数量"/>
			<check_box name="show_owner" label="所有者"/>
			<check_box name="show_group" label="群组"/>
			<check_box name="show_creator" label="创造者"/>
			<check_box name="show_last_owner" label="前所有者"/>
		</panel>
		<panel label="高级" name="area_search_advanced_panel">
			<check_box name="double_click_touch" label="双击触碰物件"/>
			<check_box name="double_click_buy" label="双击购买物件"/>
			<check_box name="double_click_sit" label="双击坐在物件上"/>
		</panel>
	</tab_container>
</floater>
