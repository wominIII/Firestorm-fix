<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="Snapshot" title="快照">
	<floater.string name="unknown">
		未知
	</floater.string>
	<string name="postcard_progress_str">
		正在发送电子邮件
	</string>
	<string name="profile_progress_str">
		发布
	</string>
	<string name="inventory_progress_str">
		保存到库存
	</string>
	<string name="local_progress_str">
		正在存到电脑
	</string>
	<string name="profile_succeeded_str">
		图像已上传
	</string>
	<string name="postcard_succeeded_str">
		电子邮件发送成功！
	</string>
	<string name="inventory_succeeded_str">
		成功存入库存！
	</string>
	<string name="local_succeeded_str">
		成功存入电脑！
	</string>
	<string name="profile_failed_str">
		上传图像到你的档案发布时出错。
	</string>
	<string name="postcard_failed_str">
		电子邮件发送失败。
	</string>
	<string name="inventory_failed_str">
		无法存入库存。
	</string>
	<string name="local_failed_str">
		无法存入电脑。
	</string>
	<view name="controls_container">
	<button label="刷新" name="new_snapshot_btn"/>
	<panel name="advanced_options_panel">
		<text name="layer_type_label">
			获取快照：
		</text>
		<combo_box label="图层" name="layer_types">
			<combo_box.item label="颜色" name="Colors"/>
			<combo_box.item label="深度" name="Depth"/>
			<combo_box.item label="深度 (24比特)" name="Depth24"/>
		</combo_box>
		<check_box label="用户界面" name="ui_check"/>
		<check_box label="L$账户余额" name="currency_check"/>
		<check_box label="HUD" name="hud_check"/>
		<check_box label="显示捕捉框架" tool_tip="在屏幕上显示一个框架，围绕快照区域。场景中超出快照范围的部分将被去饱和并稍微模糊。" name="show_frame"/>
		<check_box label="显示拍摄辅助线" name="show_guides" tool_tip="在取景范围内显示拍摄辅助线（井字构图）。"/>
		<button tool_tip="打开拍摄辅助线设置" name="guide_settings_btn"/>
		<check_box label="将帧冻结（全屏幕）" name="freeze_frame_check"/>
		<check_box label="自动刷新" name="auto_snapshot_check"/>
		<check_box label="无后期处理" name="no_post_check"/>
		<text name="filter_list_label">
			滤镜：
		</text>
		<combo_box name="filters_combobox" tool_tip="图像滤镜">
			<combo_box.item label="不用滤镜" name="NoFilter"/>
		</combo_box>
	</panel>
	<panel name="succeeded_panel">
		<text name="succeeded_lbl">
			成功
		</text>
	</panel>
	<panel name="failed_panel">
		<text name="failed_lbl">
			失败
		</text>
	</panel>
	<text name="working_lbl">
		请等待
	</text>
	<text name="refresh_lbl">
		更新以保存
	</text>
	</view>
	<text name="image_res_text">
		[WIDTH]像素（宽）x [HEIGHT]像素（高）
	</text>
	<text name="file_size_label">
		[SIZE] KB
	</text>
	<button label="制作360°照片" name="360_label"/>
</floater>
