<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_profile_classified">
	<panel.string name="type_mature">
		适度成人
	</panel.string>
	<panel.string name="type_pg">
		一般普级内容
	</panel.string>
	<panel.string name="l$_price">
		[PRICE]L$
	</panel.string>
	<panel.string name="click_through_text_fmt">
		[TELEPORT]瞬间传送，[MAP]地图，[PROFILE]档案
	</panel.string>
	<panel.string name="date_fmt">
		[year,datetime,slt]/[mthnum,datetime,slt]/[day,datetime,slt]
	</panel.string>
	<panel.string name="auto_renew_on">
		已启用
	</panel.string>
	<panel.string name="auto_renew_off">
		已停用
	</panel.string>
	<panel.string name="location_notice">
		（保存后将会更新）
	</panel.string>
	<string name="publish_label">
		发布
	</string>
	<string name="save_label">
		保存
	</string>
	<layout_stack name="main_classifieds_stack">
		<layout_panel name="scroll_layout_panel">
			<scroll_container name="profile_scroll">
				<panel name="info_scroll_content_panel">
					<icon label="" name="edit_icon" tool_tip="点击以选择图像"/>
					<layout_stack name="info_panel">
						<layout_panel name="main_info_panel">
							<text_editor name="classified_name">
								[name]
							</text_editor>
							<text name="classified_location_label" value="位置："/>
							<text_editor name="classified_location" value="[loading...]"/>
							<text name="content_type_label" value="内容类型："/>
							<text_editor name="content_type" value="[content type]"/>
							<text name="category_label" value="分类："/>
							<text_editor name="category" value="[category]"/>
							<text name="creation_date_label" value="创建日期："/>
							<text_editor name="creation_date" tool_tip="创建日期" value="[date]"/>
							<text name="price_for_listing_label" value="刊登费："/>
							<text_editor name="price_for_listing" tool_tip="刊登费。">
								[PRICE]
							</text_editor>
						</layout_panel>
						<layout_panel name="clickthrough_layout_panel">
							<text name="click_through_label" value="点击状况："/>
							<text_editor name="click_through_text" tool_tip="点击数据" value="[clicks]"/>
						</layout_panel>
						<layout_panel name="auto_renew_layout_panel">
							<text name="auto_renew_label" value="自动更新:"/>
							<text name="auto_renew" value="已启动"/>
						</layout_panel>
						<layout_panel name="descr_layout_panel">
							<text name="classified_desc_label" value="描述:"/>
							<text_editor name="classified_desc" value="[description]"/>
						</layout_panel>
					</layout_stack>
					<panel name="edit_panel">
						<text name="Name:">
							标题:
						</text>
						<text name="description_label">
							描述:
						</text>
						<text name="location_label">
							位置:
						</text>
						<text name="classified_location_edit">
							加载中...
						</text>
						<button label="使用当前位置" name="set_to_curr_location_btn"/>
						<text name="category_label" value="类别:"/>
						<text name="content_type_label" value="内容类型:"/>
						<icons_combo_box label="一般内容" name="content_type_edit">
							<icons_combo_box.item label="成人内容" name="mature_ci" value="Adult"/>
							<icons_combo_box.item label="一般内容" name="pg_ci" value="PG"/>
						</icons_combo_box>
						<check_box label="每周自动更新" name="auto_renew_edit"/>
						<text name="price_for_listing_edit_label" value="列表价格:"/>
						<spinner label="L$" name="price_for_listing_edit" tool_tip="列表价格." value="50"/>
					</panel>
				</panel>
			</scroll_container>
		</layout_panel>

		<layout_panel name="util_buttons_lp">
			<layout_stack name="util_buttons_stack">
				<layout_panel name="teleport_btn_lp">
					<button label="传送" name="teleport_btn"/>
				</layout_panel>
				<layout_panel name="map_btn_lp">
					<button label="地图" name="show_on_map_btn"/>
				</layout_panel>
				<layout_panel name="edit_btn_lp">
					<button label="编辑" name="edit_btn"/>
				</layout_panel>
			</layout_stack>
		</layout_panel>

		<layout_panel name="publish_layout_panel">
			<layout_stack name="publish_stack">
				<layout_panel name="save_btn_lp">
					<button label="[LABEL]" name="save_changes_btn"/>
				</layout_panel>
				<layout_panel name="cancel_btn_lp">
					<button label="取消" name="cancel_btn"/>
				</layout_panel>
			</layout_stack>
		</layout_panel>
	</layout_stack>
</panel>
