<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="gesture_preview">
	<floater.string name="step_anim">
		要播放的动画：
	</floater.string>
	<floater.string name="step_sound">
		要播放的声音：
	</floater.string>
	<floater.string name="step_chat">
		要说出的聊天文本：
	</floater.string>
	<floater.string name="step_wait">
		等待：
	</floater.string>
	<floater.string name="stop_txt">
		停止
	</floater.string>
	<floater.string name="preview_txt">
		预览
	</floater.string>
	<floater.string name="none_text">
		-- 无 --
	</floater.string>
	<floater.string name="Title">
		手势：[NAME]
	</floater.string>
	<text name="desc_label">
		描述：
	</text>
	<text name="trigger_label">
		触发：
	</text>
	<text name="replace_text" tool_tip="用这些字符替换触发字符。 例如，触发 &apos;hello&apos; 替换为 &apos;howdy&apos; 后，将使得聊天文本“我想说 hello”变成“我想说 howdy”，同时还会播放该手势！">
		替换成：
	</text>
	<line_editor name="replace_editor" tool_tip="用这些字符替换触发字符。 例如，触发 &apos;hello&apos; 替换为 &apos;howdy&apos; 后，将使得聊天文本“我想说 hello”变成“我想说 howdy”，同时还会播放该手势。"/>
	<text name="key_label">
		快捷键：
	</text>
	<combo_box label="无" name="modifier_combo"/>
	<combo_box label="无" name="key_combo"/>
	<text name="library_label">
		资源库：
	</text>
	<scroll_list name="library_list">
		<scroll_list.rows name="action_animation" value="动画"/>
		<scroll_list.rows name="action_sound" value="声音"/>
		<scroll_list.rows name="action_chat" value="聊天"/>
		<scroll_list.rows name="action_wait" value="等待"/>
	</scroll_list>
	<button label="添加 &gt;&gt;" name="add_btn"/>
	<text name="steps_label">
		步骤：
	</text>
	<button label="上移键" name="up_btn"/>
	<button label="下移键" name="down_btn"/>
	<button label="移除" name="delete_btn"/>
	<text name="options_text">
		（选项）
	</text>
	<radio_group name="animation_trigger_type">
		<radio_item label="开始" name="start"/>
		<radio_item label="停止" name="stop"/>
	</radio_group>
	<check_box label="直到按键释放" name="wait_key_release_check"/>
	<check_box label="直到动画结束。" name="wait_anim_check"/>
	<check_box label="时间（秒）：" name="wait_time_check"/>
	<text name="help_label">
		所有步骤都会同时进行，除非你加入“等待”步骤。
	</text>
	<check_box label="可用" name="active_check" tool_tip="你可以在聊天中键入“触发字符”，或按某手势的热键来启用可用的手势。  热键的绑定若有冲突，通常会使手势变成不可用。"/>
	<button label="预览" name="preview_btn"/>
	<button label="保存" name="save_btn"/>
</floater>
