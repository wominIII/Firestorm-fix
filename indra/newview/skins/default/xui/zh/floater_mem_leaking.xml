<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="MemLeak" title="模拟内存泄露">
	<spinner label="泄露速度（字节/帧）：" name="leak_speed"/>
	<spinner label="最大内存泄露（MB）：" name="max_leak"/>
	<text name="total_leaked_label">
		当前已泄露内存：[SIZE] KB
	</text>
	<text name="note_label_1">
		[NOTE1]
	</text>
	<text name="note_label_2">
		[NOTE2]
	</text>
	<button label="开始" name="start_btn"/>
	<button label="停止" name="stop_btn"/>
	<button label="释放" name="release_btn"/>
	<button label="关闭" name="close_btn"/>
</floater>
