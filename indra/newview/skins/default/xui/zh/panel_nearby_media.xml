<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="nearby_media">
	<string name="media_item_count_format">
		(%ld 项媒体物件）
	</string>
	<string name="empty_item_text">
		&lt;空白&gt;
	</string>
	<string name="parcel_media_name">
		地块串流媒体
	</string>
	<string name="parcel_audio_name">
		地块串流音乐
	</string>
	<string name="playing_suffix">
		（播放中）
	</string>
	<panel name="minimized_controls">
		<button label="全部停止" name="all_nearby_media_disable_btn" tool_tip="关闭附近全部的媒体"/>
		<button label="全部开始" name="all_nearby_media_enable_btn" tool_tip="开启附近全部的媒体"/>
		<button name="open_prefs_btn" tool_tip="打开媒体偏好设置"/>
		<button label="细节&gt;&gt;" label_selected="&lt;&lt;基本" name="more_btn" tool_tip="进阶控制"/>
	</panel>
	<panel name="nearby_media_panel">
		<text name="nearby_media_title">
			附近媒体
		</text>
		<text name="show_text">
			显示：
		</text>
		<combo_box name="show_combo">
			<combo_box.item label="全部" name="All"/>
			<combo_box.item label="在此地块内" name="WithinParcel"/>
			<combo_box.item label="在此地块外部" name="OutsideParcel"/>
			<combo_box.item label="在其他化身身上" name="OnOthers"/>
		</combo_box>
		<scroll_list name="media_list">
			<scroll_list.columns label="邻近" name="media_proximity"/>
			<scroll_list.columns label="可看到" name="media_visibility"/>
			<scroll_list.columns label="类型" name="media_class"/>
			<scroll_list.columns label="名称" name="media_name"/>
			<scroll_list.columns label="调试" name="media_debug"/>
		</scroll_list>
		<panel name="media_controls_panel">
			<layout_stack name="media_controls">
				<layout_panel name="stop">
					<button name="stop_btn" tool_tip="停止所选择媒体"/>
				</layout_panel>
				<layout_panel name="play">
					<button name="play_btn" tool_tip="播放所选择的媒体"/>
				</layout_panel>
				<layout_panel name="pause">
					<button name="pause_btn" tool_tip="暂停所选择的媒体"/>
				</layout_panel>
				<layout_panel name="volume_slider_ctrl">
					<slider_bar initial_value="0.5" name="volume_slider" tool_tip="所选择的媒体之音频音量"/>
				</layout_panel>
				<layout_panel name="mute">
					<button name="mute_btn" tool_tip="静音所选择的媒体音频"/>
				</layout_panel>
				<layout_panel name="zoom">
					<button name="zoom_btn" tool_tip="以所选媒体为中心放大"/>
				</layout_panel>
				<layout_panel name="unzoom">
					<button name="unzoom_btn" tool_tip="缩小所选媒体"/>
				</layout_panel>
			</layout_stack>
		</panel>
	</panel>
</panel>
