<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="script panel">
	<panel.string name="loading">
		加载中...
	</panel.string>
	<panel.string name="can_not_view">
		你无法查看或编辑这脚本，它被设为“禁止复制”。 你需要完整权限去查看或编辑物件内的脚本。
	</panel.string>
	<panel.string name="public_objects_can_not_run">
		公开物件不能运行脚本
	</panel.string>
	<panel.string name="script_running">
		运行中
	</panel.string>
	<panel.string name="Title">
		脚本：[NAME]
	</panel.string>
	<panel.string name="external_editor_not_set">
		由环境变量设置 LL_SCRIPT_EDITOR 或是 ExternalEditor 设置来选择一个编辑器。
	</panel.string>
	<menu_bar name="script_menu">
		<menu label="文件" name="File">
			<menu_item_call label="保存" name="Save"/>
			<menu_item_call label="还原全部变更" name="Revert All Changes"/>
			<menu_item_call label="从文件加载…" name="LoadFromFile"/>
			<menu_item_call label="存入文件…" name="SaveToFile"/>
			<menu_item_call label="脚本编辑器偏好设置" name="ScriptPrefs"/>
		</menu>
		<menu label="编辑" name="Edit">
			<menu_item_call label="撤销" name="Undo"/>
			<menu_item_call label="重做" name="Redo"/>
			<menu_item_call label="剪切" name="Cut"/>
			<menu_item_call label="复制" name="Copy"/>
			<menu_item_call label="粘贴" name="Paste"/>
			<menu_item_call label="全选" name="Select All"/>
			<menu_item_call label="取消选择" name="Deselect"/>
			<menu_item_call label="搜索 / 替换..." name="Search / Replace..."/>
			<menu_item_call label="前往某行数…" name="Go to line..."/>
		</menu>
		<menu label="帮助" name="Help">
			<menu_item_call label="帮助..." name="Help..."/>
			<menu_item_call label="关键字帮助..." name="Keyword Help..."/>
			<menu_item_call label="脚本库" name="Script Library"/>
		</menu>
	</menu_bar>
	<layout_stack name="script_editor_button_bar">
		<layout_panel name="script_editor_buttons_panel">
			<button tool_tip="保存脚本" name="save_btn"/>
			<button tool_tip="外部脚本编辑器" name="Edit_btn"/>
			<button tool_tip="从硬盘加载脚本" name="load_disk_btn"/>
			<button tool_tip="将脚本保存到硬盘" name="save_disk_btn"/>
			<button tool_tip="剪切" name="cut_btn"/>
			<button tool_tip="复制" name="copy_btn"/>
			<button tool_tip="粘贴" name="paste_btn"/>
			<button tool_tip="撤销" name="undo_btn"/>
			<button tool_tip="重做" name="redo_btn"/>
			<button tool_tip="查找/替换" name="search_btn"/>
			<button tool_tip="脚本编辑器设置" name="prefs_btn"/>
		</layout_panel>
	</layout_stack>
	<script_editor name="Script Editor">
		加载中...
	</script_editor>
	<combo_box label="插入..." name="Insert..."/>
	<button label="编辑..." name="edit_btn_2"/>
	<button label="保存" label_selected="保存" name="save_btn_2"/>
</panel>
