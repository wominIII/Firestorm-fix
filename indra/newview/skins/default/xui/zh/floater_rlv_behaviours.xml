<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="rlv_behaviours" title="活跃的RLV限制">
	<tab_container name="behaviour_tab">
		<panel label="限制" name="behaviour_panel">
			<scroll_list name="behaviour_list" tool_tip="所有当前RLVa限制的列表。">
				<scroll_list.columns label="限制" name="behaviour"/>
				<scroll_list.columns label="物件名称" name="issuer"/>
			</scroll_list>
		</panel>
		<panel label="例外" name="exception_panel">
			<scroll_list name="exception_list" tool_tip="所有当前RLVa例外的列表。">
				<scroll_list.columns label="限制" name="behaviour"/>
				<scroll_list.columns label="来源" name="option"/>
				<scroll_list.columns label="物件名称" name="issuer"/>
			</scroll_list>
		</panel>
		<panel label="修改器" name="modifier_panel">
			<scroll_list name="modifier_list" tool_tip="所有当前RLVa修改器的列表。">
				<scroll_list.columns label="修改器" name="modifier"/>
				<scroll_list.columns label="值" name="value"/>
				<scroll_list.columns label="主物件" name="primary" />
			</scroll_list>
		</panel>
	</tab_container>
	<panel name="bottom_panel">
		<button label="复制到剪贴板" name="copy_btn"/>
	</panel>
</floater>
