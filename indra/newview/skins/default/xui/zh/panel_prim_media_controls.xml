<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="MediaControls">
	<string name="control_background_image_name">
		Inspector_Background
	</string>
	<layout_stack name="progress_indicator_area">
		<layout_panel name="media_progress_indicator">
			<progress_bar name="media_progress_bar" tool_tip="媒体加载中"/>
		</layout_panel>
	</layout_stack>
	<layout_stack name="media_controls">
		<layout_panel name="back">
			<button name="back_btn" tool_tip="向后浏览"/>
		</layout_panel>
		<layout_panel name="fwd">
			<button name="fwd_btn" tool_tip="向前浏览"/>
		</layout_panel>
		<layout_panel name="home">
			<button name="home_btn" tool_tip="首页"/>
		</layout_panel>
		<layout_panel name="media_stop">
			<button name="media_stop_btn" tool_tip="停止媒体"/>
		</layout_panel>
		<layout_panel name="reload">
			<button name="reload_btn" tool_tip="重新加载"/>
		</layout_panel>
		<layout_panel name="stop">
			<button name="stop_btn" tool_tip="停止加载"/>
		</layout_panel>
		<layout_panel name="play">
			<button name="play_btn" tool_tip="播放媒体"/>
		</layout_panel>
		<layout_panel name="pause">
			<button name="pause_btn" tool_tip="暂停媒体"/>
		</layout_panel>
		<layout_panel name="media_address">
			<line_editor name="media_address_url" tool_tip="媒体网址"/>
			<icon name="media_secure_lock_flag" tool_tip="安全浏览"/>
			<layout_stack name="media_address_url_icons">
				<layout_panel name="media_address_url_icons_wl">
					<icon name="media_whitelist_flag" tool_tip="白名单已启用"/>
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="media_play_position">
			<slider_bar initial_value="0.5" name="media_play_slider" tool_tip="视频播放进度"/>
		</layout_panel>
		<layout_panel name="skip_back">
			<button name="skip_back_btn" tool_tip="后退"/>
		</layout_panel>
		<layout_panel name="skip_forward">
			<button name="skip_forward_btn" tool_tip="快转"/>
		</layout_panel>
		<layout_panel name="media_volume">
			<button name="media_mute_button" tool_tip="把这个媒体静音"/>
			<slider name="volume_slider" tool_tip="媒体音量"/>
		</layout_panel>
		<layout_panel name="zoom_frame">
			<button name="zoom_frame_btn" tool_tip="以媒体为中心放大"/>
		</layout_panel>
		<layout_panel name="close">
			<button name="close_btn" tool_tip="缩小"/>
		</layout_panel>
		<layout_panel name="new_window">
			<button name="new_window_btn" tool_tip="用浏览器开启 URL"/>
		</layout_panel>
	</layout_stack>
</panel>
