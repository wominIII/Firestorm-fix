<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="texture picker" title="选择纹理">
	<floater.string name="choose_picture">
		点击以挑选图片
	</floater.string>
	<floater.string name="pick title">
		精选：
	</floater.string>
	<floater.string name="pick_material">
		精选: 材质
	</floater.string>
	<floater.string name="pick_texture">
		精选: 纹理
	</floater.string>
	<text name="Multiple">
		多重纹理
	</text>
	<radio_group name="mode_selection">
		<radio_item label="库存" name="inventory"/>
		<radio_item label="本地" name="local"/>
		<radio_item label="烘焙" name="bake"/>
	</radio_group>
	<text name="size_lbl">
		尺寸：
[DIMENSIONS]
	</text>
	<button label="标准" label_selected="标准" name="Default"/>
	<button label="空" label_selected="空" name="Blank"/>
	<button label="透明" label_selected="透明" name="Transparent" tool_tip="提示：如果选择了透明纹理或其他部分透明的纹理，则不会投射光线。"/>
	<button label="无" label_selected="无" name="None"/>
	<text name="preview_disabled" value="预览已禁用"/>
	<filter_editor label="纹理过滤器" name="inventory search editor"/>
	<text name="over_limit_lbl">
		选择的纹理是 [TEXDIM]。库存图像必须是正方形的，且尺寸不得小于 [MINTEXDIM]。
	</text>
	<button label="添加" label_selected="添加" name="l_add_btn"/>
	<button label="移除" label_selected="移除" name="l_rem_btn"/>
	<button label="上传" label_selected="上传" name="l_upl_btn"/>
	<scroll_list name="l_name_list">
		<column label="名称" name="unit_name"/>
	</scroll_list>
	<combo_box name="l_bake_use_texture_combo_box" tool_tip="选择烘焙纹理">
		<combo_box.item label="无" name="None"/>
	</combo_box>
	<line_editor name="TextureKey" tool_tip="纹理UUID"/>
	<button name="TextureKeyApply" label="应用UUID" tool_tip="应用此UUID的纹理"/>
	<check_box label="实时预览" name="apply_immediate_check"/>
	<button label="取消" label_selected="取消" name="Cancel"/>
	<button label="确定" label_selected="确定" name="Select"/>
</floater>