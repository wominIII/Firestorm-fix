  <text height="38" left="416" name="script_help" top="54" width="392" word_wrap="true">Paste into a script inside a modifiable object, save, then wear that object.</text>
  <text height="38" left="12" name="status_text" top="98" width="796" word_wrap="true">Controller not found.</text>
  <text height="18" left="12" name="avatars_label" top="142" width="250">Nearby avatars</text>
