<floater can_close="true" can_minimize="true" can_resize="true" height="620" layout="topleft" min_height="500" min_width="700" name="fs_rlv_remote_browser" save_rect="true" title="Remote RLV Browser" width="820">
  <text height="38" left="12" name="intro_text" top="12" width="796" word_wrap="true">Browse the shared #RLV folders of nearby avatars through their worn Relay. The target's Relay permission is always respected; this does not expose or copy inventory assets.</text>
