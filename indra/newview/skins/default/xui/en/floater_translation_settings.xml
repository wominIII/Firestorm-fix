<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 legacy_header_height="18"
 height="700"
 layout="topleft"
 name="floater_translation_settings"
 help_topic="translation_settings"
 save_rect="true"
 title="Chat Translation Settings"
 width="900">

 <string name="azure_api_key_not_verified">Azure service identifier not verified. Status: [STATUS]. Please check your settings and try again.</string>
 <string name="google_api_key_not_verified">Google API key not verified. Status: [STATUS]. Please check your key and try again.</string>
 <string name="deepl_api_key_not_verified">DeepL Auth Key key not verified. Status: [STATUS]. Please check your key and try again.</string>

 <string name="azure_api_key_verified">Azure service identifier verified.</string>
 <string name="google_api_key_verified">Google API key verified.</string>
 <string name="deepl_api_key_verified">DeepL API key verified.</string>

 <check_box
  height="16"     
  label="Enable machine translation while chatting"
  layout="topleft"
  left="10"
 name="translate_chat_checkbox"
 top="30"
 width="20" />
 <text
  follows="left|top"
  height="20"
  layout="topleft"
  left="40"
  name="incoming_mode_label"
  top_pad="10"
  width="130">
  Incoming translator:
 </text>
 <combo_box
  height="23"
  layout="topleft"
  left="170"
  name="incoming_mode"
  top_delta="-3"
  width="270">
  <combo_box.item label="Normal API" name="normal" value="1" />
  <combo_box.item label="AI model" name="gpt" value="2" />
 </combo_box>
 <text
  height="20"
  follows="left|top"
  layout="topleft"
  left="40"
  name="translate_language_label"
  top_pad="12"
  width="130">
  Translate chat into: 
 </text>
 <combo_box
  allow_text_entry="true"
  follows="left|top"
  height="23"
  left_pad="10"
  max_chars="135"
  mouse_opaque="true"
  name="translate_language_combo"
  top_delta="-5"
  width="190">
  <combo_box.item
   label="System Default"
   name="System Default Language"
   value="default" />
  <combo_box.item
   label="English"
   name="English"
   value="en" />
  <!-- After "System Default" and "English", please keep the rest of these combo_box.items in alphabetical order by the first character in the string. -->
  <combo_box.item
   label="Dansk (Danish)"
   name="Danish"
   value="da" />
  <combo_box.item
   label="Deutsch (German)"
   name="German"
   value="de" />
  <combo_box.item
   label="Español (Spanish)"
   name="Spanish"
   value="es" />
  <combo_box.item
   label="Français (French)"
   name="French"
   value="fr" />
  <combo_box.item
   label="Italiano (Italian)"
   name="Italian"
   value="it" />
  <combo_box.item
   label="Magyar (Hungarian)"
   name="Hungarian"
   value="hu" />
  <combo_box.item
   label="Nederlands (Dutch)"
   name="Dutch"
   value="nl" />
  <combo_box.item
   label="Polski (Polish)"
   name="Polish"
   value="pl" />
  <combo_box.item
   label="Português (Portuguese)"
   name="Portugese"
   value="pt" />
  <combo_box.item
   label="Русский (Russian)"
   name="Russian"
   value="ru" />
  <combo_box.item
   label="Türkçe (Turkish)"
   name="Turkish"
   value="tr" />
  <combo_box.item
   label="Українська (Ukrainian)"
   name="Ukrainian"
   value="uk" />
  <combo_box.item
   label="中文 (正體) (Chinese)"
   name="Chinese"
   value="zh" />
  <combo_box.item
   label="日本語 (Japanese)"
   name="Japanese"
   value="ja" />
  <combo_box.item
   label="한국어 (Korean)"
   name="Korean"
   value="ko" />
 </combo_box>

 <text
  follows="top|left|right"
  height="15"
  layout="topleft"
  left="40"
  name="tip"
  top_pad="20"
  width="330"
  wrap="true">
  Choose translation service:
 </text>

 <radio_group
  follows="top|left"
  height="260"
  layout="topleft"
  left_delta="10"
  name="translation_service_rg"
  top_pad="20"
  width="320">
  <radio_item
   initial_value="azure"
   label="Azure Translator"
   layout="topleft"
   name="azure" />
  <radio_item
   initial_value="google"
   label="Google Translate"
   layout="topleft"
   name="google"
   top_pad="115" />
  <radio_item
   initial_value="deepl"
   label="DeepL Translator"
   layout="topleft"
   name="deepl"
   top_pad="61" />
 </radio_group>

  <text
   follows="top|right"
   height="20"
   layout="topleft"
   left="185"
   length="1"
   name="azure_links_text"
   top_pad="-262"
   type="string"
   width="100">
    [https://learn.microsoft.com/en-us/azure/cognitive-services/translator/create-translator-resource Setup]
  </text>

  <text
   type="string"
   length="1"
   follows="top|right"
   height="20"
   layout="topleft"
   left="70"
   name="azure_api_endoint_label"
   top_pad="8"
   width="95">
    Endpoint:
  </text>
  
 <combo_box
   allow_text_entry="true"
   follows="left|top"
   name="azure_api_endpoint_combo"
   height="23"
   left_pad="10"
   width="295"
   top_delta="-4"
   max_chars="512"
   value="https://api.cognitive.microsofttranslator.com"
   combo_button.scale_image="true">
   <combo_box.item
     label="https://api.cognitive.microsofttranslator.com"
     name="global"
     value="https://api.cognitive.microsofttranslator.com" />
   <combo_box.item
     label="https://api-apc.cognitive.microsofttranslator.com"
     name="api-apc"
     value="https://api-apc.cognitive.microsofttranslator.com" />
   <combo_box.item
     label="https://api-eur.cognitive.microsofttranslator.com"
     name="api-eur"
     value="https://api-eur.cognitive.microsofttranslator.com" />
   <combo_box.item
     label="https://api-nam.cognitive.microsofttranslator.com"
     name="api-nam"
     value="https://api-nam.cognitive.microsofttranslator.com" />
  </combo_box>

 <text
  type="string"
  length="1"
  follows="top|right"
  height="20"
  layout="topleft"
  left="70"
  name="azure_api_key_label"
  top_pad="10"
  width="95">
  Azure Key:
  </text>
 <line_editor
  default_text="Enter Translator Key and click &quot;Verify&quot;"
  follows="top|left"
  height="20"
  layout="topleft"
  left_pad="10"
  max_length_chars="90"
  top_delta="-4"
  name="azure_api_key"
  width="200" />
  <text
   type="string"
   length="1"
   follows="top|right"
   height="20"
   layout="topleft"
   left="70"
   name="azure_api_region_label"
   top_pad="11"
   width="95">
    Region:
  </text>
  <line_editor
   default_text="Can be left empty for global services"
   follows="top|left"
   height="20"
   layout="topleft"
   left_pad="10"
   max_length_chars="50"
   top_delta="-4"
   name="azure_api_region"
   width="200" />
  <button
   follows="left|top"
   height="23"
   label="Verify"
   layout="topleft"
   left_pad="10"
   name="verify_azure_api_key_btn"
   top_delta="-2"
   width="90" />

 <text
  follows="top|right"
  height="20"
  layout="topleft"
  left="70"
  length="1"
  name="google_api_key_label"
  top_pad="53"
  type="string"
  width="95">
  Google [http://code.google.com/apis/language/translate/v2/getting_started.html#auth API key]:
 </text>
 <line_editor
  default_text="Enter Google API key and click &quot;Verify&quot;"
  follows="top|left"
  height="20"
  layout="topleft"
  left_pad="10"
  max_length_chars="50"
  top_delta="-4"
  name="google_api_key"
  width="200" />
 <button
  follows="left|top"
  height="23"
  label="Verify"
  layout="topleft"
  left_pad="10"
  name="verify_google_api_key_btn"
  top_delta="-2"
  width="90" />

 <text
  follows="top|right"
  height="20"
  layout="topleft"
  left="185"
  length="1"
  name="google_links_text"
  top_delta="-23"
  type="string"
  width="100">
  [http://code.google.com/apis/language/translate/v2/pricing.html Pricing] | [https://code.google.com/apis/console Stats] 
 </text>

    <text
     type="string"
     length="1"
     follows="top|right"
     height="20"
     layout="topleft"
     left="70"
     name="deepl_api_domain_label"
     top_pad="80"
     width="95">
        Endpoint:
    </text>

    <combo_box
      allow_text_entry="false"
      follows="left|top"
      name="deepl_api_domain_combo"
      height="23"
      left_pad="10"
      width="140"
      top_delta="-4"
      max_chars="512"
      value="https://api-free.deepl.com"
      combo_button.scale_image="true">
        <combo_box.item
          label="DeepL Free"
          name="global"
          value="https://api-free.deepl.com" />
        <combo_box.item
          label="DeepL Pro"
          name="api-apc"
          value="https://api.deepl.com" />
    </combo_box>
    
    <text
     follows="top|right"
     height="20"
     layout="topleft"
     left="70"
     length="1"
     name="deepl_api_key_label"
     top_pad="11"
     type="string"
     width="95">
      DeepL API key:
    </text>

    <line_editor
     default_text="Enter DeepL API key and click &quot;Verify&quot;"
     follows="top|left"
     height="20"
     layout="topleft"
     left_pad="10"
     max_length_chars="50"
     top_delta="-4"
     name="deepl_api_key"
     width="200" />
    
    <button
     follows="left|top"
     height="23"
     label="Verify"
     layout="topleft"
     left_pad="10"
     name="verify_deepl_api_key_btn"
     top_delta="-2"
     width="90" />

    <text
     follows="top|right"
     height="20"
     layout="topleft"
     left="185"
     length="1"
     name="deepl_links_text"
     top_delta="-53"
     type="string"
     width="100">
        [https://www.deepl.com/pro/select-country?cta=header-prices Pricing]
    </text>

 <panel
  border="true"
  follows="top|right|bottom"
  height="635"
  layout="topleft"
  left="490"
  name="outgoing_translation_panel"
  top="28"
  width="400">
   <text
   font="SansSerifBold"
   height="20"
   left="12"
    name="outgoing_translation_title"
   top="10"
    width="370">Outgoing message translation</text>
   <combo_box
    height="23"
    left="12"
    name="outgoing_mode"
    top_pad="4"
    width="363">
     <combo_box.item label="Off" name="off" value="0" />
     <combo_box.item label="Normal API" name="normal" value="1" />
     <combo_box.item label="Context AI" name="gpt" value="2" />
   </combo_box>
   <text height="18" left="12" name="outgoing_target_language_label" top_pad="8" width="105">Target language:</text>
   <line_editor
    control_name="FSOutgoingTranslateLanguage"
    height="22"
    left="125"
    name="outgoing_target_language"
    top_delta="-3"
    width="250" />
   <text height="18" left="12" name="outgoing_send_format_label" top_pad="8" width="105">Send format:</text>
   <combo_box
    control_name="FSOutgoingTranslateFormat"
    height="22"
    left="125"
    name="outgoing_send_format"
    top_delta="-3"
    width="250">
     <combo_box.item label="Translation only" name="translated" value="0" />
     <combo_box.item label="Original + translation" name="original_first" value="1" />
     <combo_box.item label="Translation + original" name="translation_first" value="2" />
   </combo_box>
   <text height="18" left="12" name="outgoing_gpt_url_label" top_pad="10" width="105">GPT Base URL:</text>
   <line_editor
    control_name="FSOutgoingGPTBaseURL"
    height="22"
    left="125"
    max_length_chars="512"
    name="outgoing_gpt_url"
    top_delta="-3"
    width="250" />
   <text height="18" left="12" name="outgoing_gpt_key_label" top_pad="8" width="105">API key:</text>
   <line_editor
    control_name="FSOutgoingGPTAPIKey"
    height="22"
    is_password="true"
    left="125"
    max_length_chars="512"
    name="outgoing_gpt_key"
    top_delta="-3"
    width="250" />
   <text height="18" left="12" name="outgoing_gpt_model_label" top_pad="8" width="105">Model:</text>
   <line_editor
    control_name="FSOutgoingGPTModel"
    height="22"
    left="125"
    max_length_chars="128"
    name="outgoing_gpt_model"
    top_delta="-3"
    width="250" />
   <text height="18" left="12" name="outgoing_gpt_context_label" top_pad="8" width="105">Context messages:</text>
   <spinner
    control_name="FSOutgoingGPTContextCount"
    decimal_digits="0"
    height="22"
    increment="1"
    left="125"
    max_val="30"
    min_val="0"
    name="outgoing_gpt_context"
    top_delta="-3"
    width="75" />
   <text height="18" left="12" name="outgoing_gpt_prompt_label" top_pad="9" width="360">Editable system prompt ({target_language} is supported):</text>
   <text_editor
    control_name="FSOutgoingGPTPrompt"
    follows="left|right|bottom"
    height="82"
    left="12"
    max_length="8000"
    name="outgoing_gpt_prompt"
    right="-12"
    top_pad="3"
    wrap="true" />
   <text
    height="32"
    left="12"
    name="outgoing_gpt_context_note"
    top_pad="5"
    width="370"
    wrap="true">The AI receives only the latest messages from the current nearby, group, or private conversation.</text>
   <view_border
    height="1"
    left="12"
    right="-12"
    top_pad="8" />
   <text
    font="SansSerifBold"
    height="20"
    left="12"
    name="script_dialog_translation_title"
    top_pad="8"
    width="230">Script object menu translation</text>
   <button
    follows="right|top"
    height="22"
    label="Clear cache..."
    layout="topleft"
    left="247"
    name="clear_script_dialog_cache_btn"
    tool_tip="Delete all saved automatic translations and manual corrections for script object menus."
    top_delta="-3"
    width="128" />
   <combo_box
    height="23"
    left="12"
    name="script_dialog_translate_mode"
    top_pad="4"
    width="363">
     <combo_box.item label="Off" name="off" value="0" />
     <combo_box.item label="Normal API" name="normal" value="1" />
     <combo_box.item label="Context AI" name="gpt" value="2" />
   </combo_box>
   <text height="18" left="12" name="script_dialog_target_language_label" top_pad="8" width="105">Target language:</text>
   <line_editor
    control_name="FSScriptDialogTranslateLanguage"
    height="22"
    left="125"
    name="script_dialog_target_language"
    top_delta="-3"
    width="250" />
   <text height="18" left="12" name="script_dialog_gpt_prompt_label" top_pad="8" width="360">AI menu prompt ({target_language} is supported):</text>
   <text_editor
    control_name="FSScriptDialogGPTPrompt"
    height="70"
    left="12"
    max_length="8000"
    name="script_dialog_gpt_prompt"
    right="-12"
    top_pad="3"
    wrap="true" />
   <text
    height="24"
    left="12"
    name="script_dialog_translation_note"
    top_pad="4"
    width="370"
    wrap="true">AI mode reuses the GPT Base URL, API key and model above. Translations are saved locally.</text>
   <button
    height="22"
    label="Export backup..."
    left="12"
    name="export_localization_backup_btn"
    tool_tip="Back up inventory local labels and manually corrected script menu translations. API keys are not included."
    top_pad="5"
    width="175" />
   <button
    height="22"
    label="Import backup..."
    left_pad="8"
    name="import_localization_backup_btn"
    tool_tip="Merge local labels and manual script menu corrections from a backup file."
    width="175" />
 </panel>

 <button
  follows="left|top"
  height="23"
  label="OK"
  layout="topleft"
  right="-120"
  name="ok_btn"
  top="-30"
  width="100" />
 <button
  follows="left|top"
  height="23"
  label="Cancel"
  layout="topleft"
  left_pad="10"
  name="cancel_btn"
  width="100" />	
</floater>
