<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 bg_alpha_image="Rounded_Rect"
 bg_opaque_image="Rounded_Rect"
 background_visible="false"
 can_close="false"
 can_dock="false"
 can_minimize="false"
 can_resize="false"
 chrome="true"
 follows="bottom"
 header_height="0"
 height="340"
 help_topic="fs_wearable_favorites"
 layout="topleft"
 legacy_header_height="0"
 name="floater_fs_wearable_favorites"
 save_rect="false"
 save_visibility="true"
 show_title="false"
 single_instance="true"
 reuse_instance="true"
 title="Quick Equipment Shelf"
 width="360">
    <floater.string name="empty_list">
        Drag HUDs, attachments, clothes or gestures here. Click once to use; click again to retract.
    </floater.string>
    <floater.string name="search_no_items">
        No matching items found.
    </floater.string>
    <icon
     follows="all"
     image_name="Rounded_Rect"
     layout="topleft"
     left="0"
     name="home_indicator"
     top="0"
     right="-1"
     bottom="-1"
     visible="false" />
    <panel
     background_visible="true"
     background_opaque="true"
     bg_alpha_color="0.035 0.04 0.05 0.96"
     bg_opaque_color="0.035 0.04 0.05 0.96"
     bg_opaque_image="Rounded_Rect"
     bg_opaque_image_overlay="0.035 0.04 0.05 0.96"
     follows="all"
     layout="topleft"
     left="0"
     name="drawer_panel"
     top="0"
     right="-1"
     bottom="-1">
        <text
         follows="left|top"
         font="SansSerifLarge"
         font.style="BOLD"
         height="24"
         layout="topleft"
         left="14"
         name="shelf_title"
         text_color="White"
         top="10"
         value="Quick Equipment Shelf"
         width="220" />
        <check_box
         follows="right|top"
         height="18"
         label="Auto-hide"
         layout="topleft"
         name="auto_hide_check"
         label_text.text_color="White"
         right="-12"
         top="13"
         value="true"
         width="92" />
        <filter_editor
         follows="left|top|right"
         height="25"
         layout="topleft"
         left="12"
         label="Filter shelf"
         max_length_chars="300"
         name="wearable_filter_input"
         top="42"
         right="-84" />
        <menu_button
         follows="right|top"
         height="25"
         image_hover_unselected="Toolbar_Middle_Over"
         image_overlay="Conv_toolbar_sort"
         image_selected="Toolbar_Middle_Selected"
         image_unselected="Toolbar_Middle_Off"
         layout="topleft"
         name="options_btn"
         right="-45"
         tool_tip="Sort shelf"
         top="42"
         width="31" />
        <button
         follows="right|top"
         height="25"
         image_hover_unselected="Toolbar_Middle_Over"
         image_overlay="TrashItem_Off"
         image_selected="Toolbar_Middle_Selected"
         image_unselected="Toolbar_Middle_Off"
         layout="topleft"
         name="remove_btn"
         right="-12"
         tool_tip="Remove the last used shortcut"
         top="42"
         width="31" />
        <fs_wearable_favorites_items_list
         follows="all"
         layout="topleft"
         left="8"
         name="favorites_list"
         top="75"
         right="-8"
         bottom="-12"
         multi_select="false"
         standalone="true"
         show_create_new="false"
         worn_indication_enabled="true" />
    </panel>
</floater>
