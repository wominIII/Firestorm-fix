<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="preview_texture">
	<floater.string name="Title">
		纹理：[NAME]
	</floater.string>
	<floater.string name="Copy">
		复制到库存
	</floater.string>
	<floater.string name="DateTime">
		[year,datetime,slt], [month,datetime,slt]. [day,datetime,slt] [weekday,datetime,slt] [hour,datetime,slt]:[min,datetime,slt]:[second,datetime,slt] [timezone,datetime,slt]
	</floater.string>
	<text name="desc txt">
		描述:
	</text>
	<text name="uploader_label">
		上传者:
	</text>
	<button label="档案" name="openprofile"/>
	<text name="upload_time_label">
		时间:
	</text>
	<text name="uuid_label">
		UUID:
	</text>
	<button label="复制" name="copyuuid"/>
	<panel name="dimensions_panel">
		<text name="dimensions">
			[WIDTH]像素 x [HEIGHT]像素
		</text>
		<text name="aspect_ratio">
			宽高比
		</text>
		<combo_box name="combo_aspect_ratio" tool_tip="以预定义的宽高比显示">
			<combo_item name="Unconstrained">
				无限制
			</combo_item>
			<combo_item name="1:1" tool_tip="群组徽章或描述">
				1:1
			</combo_item>
			<combo_item name="4:3" tool_tip="[CURRENT_GRID]配置文件">
				4:3
			</combo_item>
			<combo_item name="10:7" tool_tip="广告和搜索结果，地标">
				10:7
			</combo_item>
			<combo_item name="3:2" tool_tip="关于土地">
				3:2
			</combo_item>
			<combo_item name="16:10">
				16:10
			</combo_item>
			<combo_item name="16:9" tool_tip="配置文件选择">
				16:9
			</combo_item>
			<combo_item name="2:1">
				2:1
			</combo_item>
		</combo_box>
	</panel>
	<panel name="button_panel">
		<button label="确定" name="Keep"/>
		<button label="丢弃" name="Discard"/>
		<flyout_button label="保存..." name="save_tex_btn">
			<flyout_button.item label="保存为TGA" name="save_item_tga"/>
			<flyout_button.item label="保存为PNG" name="save_item_png"/>
		</flyout_button>
	</panel>
</floater>
