<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="edit_hair_panel">
	<panel name="avatar_hair_color_panel">
		<texture_picker label="纹理" name="Texture" tool_tip="点击以挑选图片"/>
	</panel>
	<accordion name="wearable_accordion">
		<panel name="hair_color_tab_holder" title="颜色">
			<accordion name="hair_color_accordion">
				<accordion_tab name="hair_color_tab" title="颜色"/>
			</accordion>
		</panel>
		<panel name="hair_style_tab_holder" title="风格">
			<accordion name="hair_style_accordion">
				<accordion_tab name="hair_style_tab" title="风格"/>
			</accordion>
		</panel>
		<panel name="hair_eyebrows_tab_holder" title="眉毛">
			<accordion name="hair_eyebrows_accordion">
				<accordion_tab name="hair_eyebrows_tab" title="眉毛"/>
			</accordion>
		</panel>
		<panel name="hair_facial_tab_holder" title="面部">
			<text name="hair_facial_not_available">
				面部选项仅适用于男性化身。
			</text>
			<accordion name="hair_facial_accordion">
				<accordion_tab name="hair_facial_tab" title="面部"/>
			</accordion>
		</panel>
	</accordion>
</panel>
